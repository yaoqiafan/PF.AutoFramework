<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\Common.Desktop.props" Condition="Exists('..\Common.Desktop.props')" />
	<ItemGroup>
		<PackageReference Include="Prism.Wpf" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\PF.Infrastructure\PF.Infrastructure.csproj" />
	  <ProjectReference Include="..\PF.UI.Infrastructure\PF.UI.Infrastructure.csproj" />
	</ItemGroup>
	<ItemGroup>
	  <Reference Include="PF.UI.Controls">
	    <HintPath>..\DLL\PF.UI.Controls.dll</HintPath>
	  </Reference>
	  <Reference Include="PF.UI.Resources">
	    <HintPath>..\DLL\PF.UI.Resources.dll</HintPath>
	  </Reference>
	  <Reference Include="PF.UI.Shared">
	    <HintPath>..\DLL\PF.UI.Shared.dll</HintPath>
	  </Reference>
	</ItemGroup>

	<PropertyGroup>
		<IsModuleProject>true</IsModuleProject>
		<IsPackable>true</IsPackable>
		<Description>硬件调试面板：设备连接/断开、轴运动、IO 状态测试</Description>
		<GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
	</PropertyGroup>
</Project>