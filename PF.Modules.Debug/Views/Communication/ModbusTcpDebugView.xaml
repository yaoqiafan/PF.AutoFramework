<UserControl
    x:Class="PF.Modules.Debug.Views.Communication.ModbusTcpDebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oplog="clr-namespace:PF.UI.Infrastructure.Operation;assembly=PF.UI.Infrastructure"
    xmlns:opkeys="clr-namespace:PF.Modules.Debug"
    xmlns:pf="clr-namespace:PF.UI.Controls;assembly=PF.UI.Controls"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="640"
    d:DesignWidth="900"
    prism:ViewModelLocator.AutoWireViewModel="True"
    oplog:OperationLog.PageName="ModbusTcpDebugView"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <pf:TransitioningContentControl TransitionMode="Right2LeftWithFade" TransitionStoryboard="{StaticResource Right2LeftWithFadeTransition}">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  头部信息卡  -->
            <Border
                Grid.Row="0"
                Margin="0,0,0,15"
                Padding="15"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="{DynamicResource FontSize.H2.Title}"
                            FontWeight="Bold"
                            Text="Modbus TCP 主站" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="13"
                            Text="{Binding TargetEndpoint, StringFormat='目标从站：{0}'}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,15,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSize.Body.Standard}"
                            FontWeight="SemiBold"
                            Text="{Binding StatusText, StringFormat='状态：{0}'}" />
                        <Button
                            Height="32"
                            Margin="0,0,10,0"
                            Command="{Binding ConnectCommand}"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+ModbusTcpDebugView.Connect}"
                            Content="连接"
                            Style="{DynamicResource ButtonDefault}" />
                        <Button
                            Height="32"
                            Margin="0,0,10,0"
                            Command="{Binding DisconnectCommand}"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+ModbusTcpDebugView.Disconnect}"
                            Content="断开"
                            Style="{DynamicResource ButtonWarning}" />
                        <Button
                            Height="32"
                            Command="{Binding ShowParamDialogCommand}"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+ModbusTcpDebugView.ShowParamDialog}"
                            Content="参数设置"
                            Style="{DynamicResource ButtonDefault}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  读写测试面板  -->
            <Border
                Grid.Row="1"
                Margin="0,0,0,15"
                Padding="12"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel>
                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="读写测试" />
                        <!--  勾选切换进制时，已填的地址/写入值自动在两种进制表示间换算；从站地址与数量始终十进制  -->
                        <CheckBox
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            Content="地址/写入值按十六进制填写"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+ModbusTcpDebugView.UseHexInput}"
                            IsChecked="{Binding UseHexInput}" />
                        <!--  MBAP 事务号控制：递增模式显示"重置事务号"，固定模式显示事务号输入框（互斥）  -->
                        <CheckBox
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            Content="事务号递增"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+ModbusTcpDebugView.TransactionIdIncrement}"
                            IsChecked="{Binding TransactionIdIncrement}" />
                        <!--  递增模式：计数器归零，下一笔请求从 1 开始  -->
                        <Button
                            Height="26"
                            Margin="12,0,0,0"
                            Padding="10,0"
                            VerticalAlignment="Center"
                            Command="{Binding ResetTransactionIdCommand}"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+ModbusTcpDebugView.ResetTransactionId}"
                            Content="重置事务号"
                            Style="{DynamicResource ButtonDefault}"
                            Visibility="{Binding TransactionIdIncrement, Converter={StaticResource BoolToVis}}" />
                        <!--  固定模式：手动填写事务号（十六进制 0~FFFF，发送时生效）  -->
                        <TextBlock
                            Margin="12,0,4,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#64748B"
                            Text="事务号(HEX):"
                            Visibility="{Binding IsTransactionIdFixed, Converter={StaticResource BoolToVis}}" />
                        <TextBox
                            Width="64"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+ModbusTcpDebugView.FixedTransactionIdText}"
                            Text="{Binding FixedTransactionIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="固定模式下每次请求使用的事务号（十六进制，0~FFFF），递增模式下被忽略"
                            Visibility="{Binding IsTransactionIdFixed, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="功能码" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="从站地址" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="起始地址" />
                        <!--  标签随功能码变化：读时显示"读取个数"，写多个时显示"写入个数"，写单个时显示"单写不使用"，避免误导  -->
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding QuantityLabel}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="4"
                            Text="写入值"
                            Visibility="{Binding IsSingleWriteFunction, Converter={StaticResource BoolToVis}}" />

                        <ComboBox
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,4,10,0"
                            ItemsSource="{Binding FunctionCodes}"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+ModbusTcpDebugView.FunctionCode}"
                            SelectedItem="{Binding SelectedFunctionCode, Mode=TwoWay}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,10,0" oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+ModbusTcpDebugView.UnitId}" Text="{Binding UnitId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Row="1" Grid.Column="2" Margin="0,4,10,0" oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+ModbusTcpDebugView.AddressText}" Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Row="1" Grid.Column="3" Margin="0,4,10,0" oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+ModbusTcpDebugView.Quantity}" Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <!--  写单个线圈/寄存器：单值输入框  -->
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="4"
                            Margin="0,4,10,0"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+ModbusTcpDebugView.WriteValueText}"
                            Text="{Binding WriteValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{Binding IsSingleWriteFunction, Converter={StaticResource BoolToVis}}" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="6"
                            Width="100"
                            Margin="0,4,0,0"
                            Command="{Binding ExecuteTestCommand}"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+ModbusTcpDebugView.ExecuteTest}"
                            Content="执行"
                            Style="{DynamicResource ButtonDefault}" />
                    </Grid>

                    <!--  写多个线圈/寄存器：每个位置独立填值，随"写入个数"自动增删，不再是"全部写同一个值"  -->
                    <Border
                        Margin="0,10,0,0"
                        Padding="8"
                          Background="{DynamicResource ThirdlyRegionBrush}"

                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding IsMultiWriteFunction, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="12"
                                Foreground="#64748B"
                                Text="逐位置填值（线圈填 0/1，寄存器按所选进制填写）：" />
                            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding MultiWriteValues}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,10,6" Orientation="Horizontal">
                                                <TextBlock
                                                    MinWidth="28"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding Index, StringFormat='[{0}]'}" />
                                                <TextBox Width="70" oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+ModbusTcpDebugView.MultiWriteValue}" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!--  报文预览：TransactionId 以 00 00 占位（发送时才分配），其余与实际发送帧逐字节一致  -->
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            FontSize="12"
                            Foreground="#64748B"
                            Text="报文预览：" />
                        <TextBox
                            Background="Transparent"
                            BorderThickness="0"
                            FontFamily="Consolas"
                            IsReadOnly="True"
                            Text="{Binding FramePreview, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!--  原始报文直发：PDU 透传（不校验功能码回显，从站异常响应原样返回），MBAP 头自动补全  -->
            <Border
                Grid.Row="2"
                Margin="0,0,0,15"
                Padding="12"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="原始报文直发（PDU 透传，复用上方从站地址）" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            FontFamily="Consolas"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+ModbusTcpDebugView.RawPduText}"
                            Text="{Binding RawPduText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="PDU＝功能码+数据，十六进制字符串（如 03 00 00 00 02，可含空格/短横线分隔），MBAP 头由框架自动补全" />
                        <Button
                            Grid.Column="1"
                            Width="100"
                            Command="{Binding SendRawCommand}"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+ModbusTcpDebugView.SendRaw}"
                            Content="发送"
                            Style="{DynamicResource ButtonDefault}" />
                    </Grid>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            FontSize="12"
                            Foreground="#64748B"
                            Text="完整帧预览：" />
                        <TextBox
                            Background="Transparent"
                            BorderThickness="0"
                            FontFamily="Consolas"
                            IsReadOnly="True"
                            Text="{Binding RawFramePreview, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!--  日志：只读多行文本框，支持鼠标框选 + Ctrl+C 复制（含每次事务的原始报文十六进制）  -->
            <Border
                Grid.Row="3"
                Padding="10"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6">
                <DockPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        DockPanel.Dock="Top"
                        FontWeight="SemiBold"
                        Text="事件日志（含收发报文，可框选复制）" />
                    <TextBox
                        FontFamily="Consolas"
                        HorizontalScrollBarVisibility="Auto"
                        IsReadOnly="True"
                        Text="{Binding LogText, Mode=OneWay}"
                        TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </Border>
        </Grid>
    </pf:TransitioningContentControl>
</UserControl>
