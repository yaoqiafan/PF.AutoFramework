<UserControl
    x:Class="PF.Modules.Debug.Views.Communication.TcpServerDebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oplog="clr-namespace:PF.UI.Infrastructure.Operation;assembly=PF.UI.Infrastructure"
    xmlns:opkeys="clr-namespace:PF.Modules.Debug"
    xmlns:pf="clr-namespace:PF.UI.Controls;assembly=PF.UI.Controls"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="500"
    d:DesignWidth="900"
    prism:ViewModelLocator.AutoWireViewModel="True"
    oplog:OperationLog.PageName="TcpServerDebugView"
    mc:Ignorable="d">

    <pf:TransitioningContentControl TransitionMode="Right2LeftWithFade" TransitionStoryboard="{StaticResource Right2LeftWithFadeTransition}">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  头部信息卡  -->
            <Border
                Grid.Row="0"
                Margin="0,0,0,15"
                Padding="15"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="{DynamicResource FontSize.H2.Title}"
                            FontWeight="Bold"
                            Text="{Binding ServerName, StringFormat='TCP 服务端：{0}'}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="13"
                            Text="{Binding ListenEndpoint, StringFormat='监听地址：{0}'}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,15,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="{DynamicResource FontSize.Body.Standard}"
                            FontWeight="SemiBold"
                            Text="{Binding StatusText, StringFormat='状态：{0}'}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            HorizontalAlignment="Right"
                            FontSize="{DynamicResource FontSize.Body.Small}"
                            Foreground="#64748B"
                            Text="{Binding Clients.Count, StringFormat='已连接客户端：{0}'}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Height="32"
                            Margin="0,0,10,0"
                            Command="{Binding StartCommand}"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+TcpServerDebugView.Start}"
                            Content="启动"
                            Style="{DynamicResource ButtonDefault}" />
                        <Button
                            Height="32"
                            Margin="0,0,10,0"
                            Command="{Binding StopCommand}"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+TcpServerDebugView.Stop}"
                            Content="停止"
                            Style="{DynamicResource ButtonWarning}" />
                        <Button
                            Height="32"
                            Command="{Binding ShowParamDialogCommand}"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+TcpServerDebugView.ShowParamDialog}"
                            Content="参数设置"
                            Style="{DynamicResource ButtonDefault}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  发送测试数据：广播 / 单播到选中客户端  -->
            <Border
                Grid.Row="1"
                Margin="0,0,0,15"
                Padding="12"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+TcpServerDebugView.SendText}"
                        Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        Width="100"
                        Margin="0,0,10,0"
                        Command="{Binding BroadcastCommand}"
                        oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+TcpServerDebugView.Broadcast}"
                        Content="广播发送"
                        Style="{DynamicResource ButtonDefault}" />
                    <Button
                        Grid.Column="2"
                        Width="140"
                        Margin="0,0,10,0"
                        Command="{Binding SendToClientCommand}"
                        oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+TcpServerDebugView.SendToClient}"
                        Content="发送到选中客户端"
                        Style="{DynamicResource ButtonDefault}" />
                    <Button
                        Grid.Column="3"
                        Width="140"
                        Command="{Binding DisconnectClientCommand}"
                        oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+TcpServerDebugView.DisconnectClient}"
                        Content="断开选中客户端"
                        Style="{DynamicResource ButtonWarning}" />
                </Grid>
            </Border>

            <!--  客户端列表 + 日志  -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="10"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="6">
                    <DockPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            DockPanel.Dock="Top"
                            FontWeight="SemiBold"
                            Text="已连接客户端" />
                        <ListBox ItemsSource="{Binding Clients}" oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+TcpServerDebugView.SelectedClient}" SelectedItem="{Binding SelectedClient, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding ClientId}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="#64748B"
                                            Text="{Binding RemoteEndPoint}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="#94A3B8"
                                            Text="{Binding ConnectedTime, StringFormat='连接于 {0:HH:mm:ss}'}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border
                    Grid.Column="2"
                    Padding="10"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="6">
                    <DockPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            DockPanel.Dock="Top"
                            FontWeight="SemiBold"
                            Text="事件日志" />
                        <ListBox FontFamily="Consolas" ItemsSource="{Binding LogEntries}" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </pf:TransitioningContentControl>
</UserControl>
