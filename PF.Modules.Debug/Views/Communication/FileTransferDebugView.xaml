<UserControl
    x:Class="PF.Modules.Debug.Views.Communication.FileTransferDebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pf="clr-namespace:PF.UI.Controls;assembly=PF.UI.Controls"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    d:DesignHeight="600"
    d:DesignWidth="950"
    mc:Ignorable="d">

    <pf:TransitioningContentControl TransitionMode="Right2LeftWithFade" TransitionStoryboard="{StaticResource Right2LeftWithFadeTransition}">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="220" />
                <RowDefinition Height="15" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  头部信息卡  -->
            <Border
                Grid.Row="0"
                Margin="0,0,0,15"
                Padding="15"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="{DynamicResource FontSize.H2.Title}" FontWeight="Bold" Text="{Binding ChannelName, StringFormat='FileTransfer 通道：{0}'}" />
                        <TextBlock Margin="0,4,0,0" FontSize="13" Text="{Binding RoleText, StringFormat='角色：{0}'}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,15,0"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource FontSize.Body.Standard}"
                        FontWeight="SemiBold"
                        Text="{Binding StatusText, StringFormat='状态：{0}'}" />
                    <Button
                        Grid.Column="2"
                        Height="32"
                        VerticalAlignment="Center"
                        Command="{Binding ShowParamDialogCommand}"
                        Content="参数设置"
                        Style="{DynamicResource ButtonDefault}" />
                </Grid>
            </Border>

            <!--  测试发送区  -->
            <Border
                Grid.Row="1"
                Margin="0,0,0,15"
                Padding="12"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="测试数据大小(MB)：" />
                    <TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding TestSizeMb, UpdateSourceTrigger=PropertyChanged}" />

                    <Button
                        Grid.Column="3"
                        Width="140"
                        VerticalAlignment="Center"
                        Command="{Binding SendTestDataCommand}"
                        Content="生成并发送测试数据"
                        Style="{DynamicResource ButtonDefault}" />

                    <ProgressBar
                        Grid.Column="4"
                        Height="20"
                        Margin="15,0,0,0"
                        VerticalAlignment="Center"
                        Maximum="100"
                        Value="{Binding ProgressPercent, Mode=OneWay}" />
                </Grid>
            </Border>

            <!--  Lane 状态表  -->
            <Border Grid.Row="2" Padding="10" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" FontWeight="SemiBold" Text="各 Lane 状态" />
                    <DataGrid
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding LaneRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="60" Binding="{Binding LaneId}" Header="LaneId" />
                            <DataGridTextColumn Width="80" Binding="{Binding IsConnected}" Header="已连接" />
                            <DataGridTextColumn Width="*" Binding="{Binding RemoteEndPoint}" Header="对端地址" />
                            <DataGridTextColumn Width="100" Binding="{Binding BytesSent}" Header="发送字节数" />
                            <DataGridTextColumn Width="100" Binding="{Binding BytesReceived}" Header="接收字节数" />
                            <DataGridTextColumn Width="90" Binding="{Binding ReconnectAttempts}" Header="重连次数" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!--  事件日志  -->
            <Border Grid.Row="4" Padding="10" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" FontWeight="SemiBold" Text="事件日志" />
                    <ListBox FontFamily="Consolas" ItemsSource="{Binding LogEntries}" />
                </DockPanel>
            </Border>
        </Grid>
    </pf:TransitioningContentControl>
</UserControl>
