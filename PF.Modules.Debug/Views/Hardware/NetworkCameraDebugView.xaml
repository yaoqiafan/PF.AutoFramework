<UserControl
    x:Class="PF.Modules.Debug.Views.Hardware.NetworkCameraDebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oplog="clr-namespace:PF.UI.Infrastructure.Operation;assembly=PF.UI.Infrastructure"
    xmlns:opkeys="clr-namespace:PF.Modules.Debug"
    xmlns:pf="clr-namespace:PF.UI.Controls;assembly=PF.UI.Controls"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="900"
    d:DesignWidth="1400"
    prism:ViewModelLocator.AutoWireViewModel="True"
    oplog:OperationLog.PageName="NetworkCameraDebugView"
    mc:Ignorable="d">

    <!--  样式键与 LineScanCameraDebugView 同一套（各页面本地各放一份是本仓库现状）  -->
    <!--  样式键与 LineScanCameraDebugView 同一套（各页面本地各放一份是本仓库现状）。
          本页无内嵌参数表单，参数类样式（FieldLabel/ReadOnlyValue 等）不在此声明。  -->
    <UserControl.Resources>
        <Style x:Key="GroupBorder" TargetType="Border">
            <Setter Property="Padding" Value="15" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style
            x:Key="FieldCombo"
            BasedOn="{StaticResource ComboBoxBaseStyle}"
            TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption.Mini}" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  StaticResource 是运行时解析：本文件与全局资源字典里都没有这个键时，
              页面加载会抛 XamlParseException（整个页面白屏），而 dotnet build 报 0 错误。
              仓库现状是各页各自本地定义一份（见 IODebugView.xaml）。  -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <pf:TransitioningContentControl TransitionMode="Right2LeftWithFade" TransitionStoryboard="{StaticResource Right2LeftWithFadeTransition}">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <!--  0 头部（设备状态 + 操作） / 1 预览（占满剩余） / 2 底部状态条  -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ══ 头部：设备名 + 设备状态 + 设备操作（参数走顶部弹窗，不在页面内嵌） ══  -->
            <Border
                Grid.Row="0"
                Margin="0,0,0,12"
                Style="{StaticResource GroupBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="4,0,16,0"
                        VerticalAlignment="Center"
                        FontSize="28"
                        Foreground="{DynamicResource TextIconBrush}"
                        Text="📷" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="{DynamicResource FontSize.H1.Large}"
                                FontWeight="Bold"
                                Text="{Binding DeviceName, Mode=OneWay}" />
                            <!--  连接状态胶囊：与串口调试页「状态：xxx」同位置，此处更直观  -->
                            <Border
                                Margin="12,0,0,0"
                                Padding="8,2"
                                VerticalAlignment="Center"
                                CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F1F5F9" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCameraConnected}" Value="True">
                                                <Setter Property="Background" Value="#DCFCE7" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    FontSize="{DynamicResource FontSize.Body.Small}"
                                    Foreground="#334155"
                                    Text="{Binding ConnectionStateText, Mode=OneWay}" />
                            </Border>
                            <Border
                                Margin="8,0,0,0"
                                Padding="8,2"
                                VerticalAlignment="Center"
                                Background="#E0E7FF"
                                CornerRadius="4"
                                Visibility="{Binding IsCameraSimulated, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    FontSize="{DynamicResource FontSize.Body.Small}"
                                    Foreground="#4338CA"
                                    Text="模拟" />
                            </Border>
                        </StackPanel>

                        <!--  设备状态行：端点 / 序列号 / 当前通道 / 缓冲区  -->
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                            <TextBlock
                                FontSize="{DynamicResource FontSize.Body.Small}"
                                Foreground="#64748B"
                                Text="{Binding Endpoint, Mode=OneWay}" />
                            <TextBlock
                                Margin="16,0,0,0"
                                FontSize="{DynamicResource FontSize.Body.Small}"
                                Foreground="#64748B">
                                <Run Text="序列号:" />
                                <Run Text="{Binding ReadOnlySerialNumber, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock
                                Margin="16,0,0,0"
                                FontSize="{DynamicResource FontSize.Body.Small}"
                                Foreground="#64748B">
                                <Run Text="通道:" />
                                <Run Text="{Binding ReadOnlyChannel, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock
                                Margin="16,0,0,0"
                                FontSize="{DynamicResource FontSize.Body.Small}"
                                Foreground="#64748B">
                                <Run Text="缓冲区:" />
                                <Run Text="{Binding ReadOnlyBufferMb, Mode=OneWay}" />
                                <Run Text="MB" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Height="32"
                            Margin="0,0,8,0"
                            Command="{Binding ConnectCommand}"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+NetworkCameraDebugView.Connect}"
                            Content="登录"
                            Style="{DynamicResource ButtonDefault}" />
                        <Button
                            Height="32"
                            Margin="0,0,8,0"
                            Command="{Binding DisconnectCommand}"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+NetworkCameraDebugView.Disconnect}"
                            Content="注销"
                            Style="{DynamicResource ButtonDefault}" />
                        <Button
                            Height="32"
                            Margin="0,0,8,0"
                            Command="{Binding ResetCommand}"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+NetworkCameraDebugView.Reset}"
                            Content="复位"
                            Style="{DynamicResource ButtonWarning}" />
                        <Button
                            Height="32"
                            Command="{Binding ShowParamDialogCommand}"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+NetworkCameraDebugView.ShowParamDialog}"
                            Content="参数设置"
                            Style="{DynamicResource ButtonDefault}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ══ 预览 / 抓图 ══  -->
            <Border
                Grid.Row="1"
                Background="{DynamicResource ThirdlyRegionBrush}"
                Margin="0,0,0,0"
                Style="{StaticResource GroupBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSize.Body.Small}"
                            Text="抓图通道:" />
                        <ComboBox
                            Grid.Column="1"
                            Margin="0,0,12,0"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding Channels, Mode=OneWay}"
                            SelectedItem="{Binding SelectedChannel}"
                            Style="{StaticResource FieldCombo}" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource Hint}"
                            Text="不选 = 设备当前通道" />

                        <Button
                            Grid.Column="4"
                            Height="32"
                            Margin="0,0,8,0"
                            Command="{Binding CaptureCommand}"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+NetworkCameraDebugView.Capture}"
                            Content="抓图"
                            Style="{DynamicResource ButtonPrimary}" />
                        <Button
                            Grid.Column="5"
                            Height="32"
                            Margin="0,0,8,0"
                            Command="{Binding CaptureAndSaveCommand}"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+NetworkCameraDebugView.CaptureAndSave}"
                            Content="抓图并保存"
                            Style="{DynamicResource ButtonDefault}" />
                        <Button
                            Grid.Column="6"
                            Height="32"
                            Margin="0,0,8,0"
                            Command="{Binding StartPreviewCommand}"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+NetworkCameraDebugView.StartPreview}"
                            Content="开始预览"
                            Style="{DynamicResource ButtonDefault}" />
                        <Button
                            Grid.Column="7"
                            Height="32"
                            Command="{Binding StopPreviewCommand}"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+NetworkCameraDebugView.StopPreview}"
                            Content="停止预览"
                            Style="{DynamicResource ButtonDefault}" />
                    </Grid>

                    <!--  预览：轮询抓图喂 ImageViewer（缩放/平移/适应窗口）  -->
                    <Grid Grid.Row="1">
                        <pf:ImageViewer
                            ImageSource="{Binding PreviewImage}"
                            ShowImgMap="True"
                            ShowToolBar="True" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSize.H3.Subtitle}"
                            Foreground="#94A3B8"
                            IsHitTestVisible="False"
                            Text="{Binding PreviewHint}"
                            TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!--  ══ 底部状态条 ══  -->
            <Border
                Grid.Row="2"
                Margin="0,8,0,0"
                Padding="10,6"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource FontSize.Body.Small}"
                        Foreground="#475569"
                        Text="{Binding PreviewInfoText, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource Hint}"
                        Text="{Binding CaptureStatus, Mode=OneWay}" />
                </Grid>
            </Border>
        </Grid>
    </pf:TransitioningContentControl>
</UserControl>
