<UserControl
    x:Class="PF.Modules.Debug.Views.Hardware.LightControllerDebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PF.Modules.Debug.Views.Hardware"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oplog="clr-namespace:PF.UI.Infrastructure.Operation;assembly=PF.UI.Infrastructure"
    xmlns:opkeys="clr-namespace:PF.Modules.Debug"
    xmlns:pf="clr-namespace:PF.UI.Controls;assembly=PF.UI.Controls"
    d:DesignHeight="450"
    d:DesignWidth="800"
    oplog:OperationLog.PageName="LightControllerDebugView"
    mc:Ignorable="d">
    <pf:TransitioningContentControl TransitionMode="Right2LeftWithFade" TransitionStoryboard="{StaticResource Right2LeftWithFadeTransition}">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border
                Grid.Row="0"
                Margin="0,0,0,15"
                Padding="15"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="48"
                        Height="48"
                        Margin="0,0,15,0"
                        CornerRadius="8">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="24"
                            Foreground="{DynamicResource TextIconBrush}"
                            Text="💡" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="22"
                            FontWeight="Bold"
                            Text="{Binding DeviceName}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="13"
                            Foreground="#64748B"
                            Text="{Binding DeviceDescription}" />
                    </StackPanel>

                    <Border
                        Grid.Column="2"
                        Padding="15,0"
                        VerticalAlignment="Center"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1,0,0,0">
                        <UniformGrid
                            VerticalAlignment="Center"
                            Columns="2"
                            Rows="2">
                            <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                                <TextBlock Foreground="#64748B" Text="COM 地址: " />
                                <TextBlock FontWeight="SemiBold" Text="{Binding COMAdress}" />
                            </StackPanel>



                        </UniformGrid>
                    </Border>

                    <StackPanel
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Text="通讯状态:" />
                        <Border Padding="8,4" CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#EF4444" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Background" Value="#02AD8B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding IsConnected, StringFormat='{}{0}'}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width=" AUTO" />
                    <ColumnDefinition Width=" *" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Margin="0,0,0,15"
                    Padding="15"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#475569"
                            Text="设备启停" />
                        <UniformGrid Margin="0,0,0,10" Columns="2">
                            <Button
                                Height="36"
                                Margin="0,0,5,5"
                                Command="{Binding ConnectCommand}"
                                oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+LightControllerDebugView.Connect}"
                                Content="连接硬件"
                                Style="{DynamicResource ButtonDefault}" />
                            <Button
                                Height="36"
                                Margin="5,0,0,5"
                                Command="{Binding DisconnectCommand}"
                                oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+LightControllerDebugView.Disconnect}"
                                Content="断开连接"
                                Style="{DynamicResource ButtonDefault}" />
                        </UniformGrid>
                        <Button
                            Height="36"
                            Margin="0,5"
                            Command="{Binding ReadLightValueCommand}"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+LightControllerDebugView.ReadLightValue}"
                            Content="读取亮度"
                            Style="{DynamicResource ButtonDefault}" />
                        <Button
                            Height="36"
                            Margin="0,5"
                            Command="{Binding ResetCommand}"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+LightControllerDebugView.Reset}"
                            Content="清除报警 (RESET)"
                            Style="{DynamicResource ButtonWarning}" />
                        <Button
                            Height="36"
                            Margin="0,5"
                            Command="{Binding SimulateAlarmCommand}"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+LightControllerDebugView.SimulateAlarm}"
                            Content="模拟报警测试"
                            Style="{DynamicResource ButtonDanger}" />
                    </StackPanel>
                </Border>


                <Border
                    Grid.Column=" 1"
                    Margin="10,0,0,15"
                    Padding="15"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="6">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Channels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!--  通道行：左侧通道名，中间带刻度滑块，右侧 NumericUpDown 可直接输入数值，两者绑定同一个 Value 联动。
                                          用 NumericUpDown 而不是 TextBox：输入会按 0~255 钳位、非数字不会写进源，
                                          不会再出现"框里 300、滑块 255、硬件先后收到 300 和 255"的脱节  -->
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="{DynamicResource FontSize.H2.Title}"
                                                FontWeight="SemiBold"
                                                Text="{Binding DisplayName}" />
                                            <!--  未读取/读取失败时给出提示：此时滑块上的 0 只是初值，不是硬件读回的值  -->
                                            <TextBlock
                                                MaxWidth="86"
                                                Margin="0,2,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="11"
                                                Foreground="#EF4444"
                                                Text="{Binding ReadStatus}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding ReadStatus}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasReadProblem}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <Slider
                                            Grid.Column="1"
                                            Margin="10,0"
                                            VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True"
                                            Maximum="255"
                                            Minimum="0"
                                            TickFrequency="1"
                                            TickPlacement="None"
                                            Value="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                        <pf:NumericUpDown
                                            Grid.Column="2"
                                            Height="30"
                                            DecimalPlaces="0"
                                            Increment="1"
                                            Maximum="255"
                                            Minimum="0"
                                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+LightControllerDebugView.ChannelValueText}"
                                            Value="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>







        </Grid>



    </pf:TransitioningContentControl>

</UserControl>
