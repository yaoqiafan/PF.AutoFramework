<UserControl
    x:Class="PF.Modules.Debug.Views.IODebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:opkeys="clr-namespace:PF.Modules.Debug"
    xmlns:oplog="clr-namespace:PF.UI.Infrastructure.Operation;assembly=PF.UI.Infrastructure"
    xmlns:pf="clr-namespace:PF.UI.Controls;assembly=PF.UI.Controls"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="600"
    d:DesignWidth="900"
    oplog:OperationLog.PageName="IODebugView"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="OnColor" Color="#10B981" />
        <SolidColorBrush x:Key="OffColor" Color="#E2E8F0" />
        <SolidColorBrush x:Key="OnBorderColor" Color="#059669" />
        <SolidColorBrush x:Key="OffBorderColor" Color="#CBD5E1" />

        <DataTemplate x:Key="InputPortTemplate">
            <Border
                Height="40"
                Margin="5"
                Padding="15,10"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Orientation="Horizontal">
                    <Ellipse
                        Width="16"
                        Height="16"
                        Margin="0,0,10,0"
                        StrokeThickness="1">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource OffColor}" />
                                <Setter Property="Stroke" Value="{StaticResource OffBorderColor}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource OnColor}" />
                                        <Setter Property="Stroke" Value="{StaticResource OnBorderColor}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource FontSize.Body.Standard}"
                        FontWeight="Bold"
                        Text="{Binding PortName}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="OutputPortTemplate">
            <Button
                Height="40"
                Margin="5"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+IODebugView.ToggleOutput}"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding ToggleCommand}"
                CommandParameter="{Binding}"
                Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,10,0"
                                    StrokeThickness="1">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource OffColor}" />
                                            <Setter Property="Stroke" Value="{StaticResource OffBorderColor}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource OnColor}" />
                                                    <Setter Property="Stroke" Value="{StaticResource OnBorderColor}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock
                                    x:Name="TEXT"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource FontSize.Body.Standard}"
                                    FontWeight="Bold"
                                    Text="{Binding PortName}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8" />
                                <Setter TargetName="TEXT" Property="Foreground" Value="{DynamicResource InfoBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <pf:TransitioningContentControl TransitionMode="Right2LeftWithFade" TransitionStoryboard="{StaticResource Right2LeftWithFadeTransition}">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Margin="0,0,0,15"
                Padding="15"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="48"
                        Height="48"
                        Margin="0,0,15,0"
                        CornerRadius="8">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSize.H1.Large}"
                            Foreground="{DynamicResource TextIconBrush}"
                            Text="🔌" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="{DynamicResource FontSize.H2.Title}"
                            FontWeight="Bold"
                            Text="{Binding DeviceName}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="13"
                            Text="{Binding DeviceDescription}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Height="32"
                            Margin="0,0,10,0"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+IODebugView.Connect}"
                            Command="{Binding ConnectCommand}"
                            Content="连接硬件"
                            Style="{DynamicResource ButtonDefault}" />
                        <Button
                            Height="32"
                            Margin="0,0,10,0"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+IODebugView.Disconnect}"
                            Command="{Binding DisconnectCommand}"
                            Content="断开连接"
                            Style="{DynamicResource ButtonDefault}" />
                        <Button
                            Height="32"
                            Margin="0,0,10,0"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+IODebugView.Reset}"
                            Command="{Binding ResetCommand}"
                            Content="模块复位"
                            Style="{DynamicResource ButtonWarning}" />
                        <Button
                            Height="32"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+IODebugView.SimulateAlarm}"
                            Command="{Binding SimulateAlarmCommand}"
                            Content="模拟报警测试"
                            Style="{DynamicResource ButtonDanger}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Text="通讯状态:" />
                        <Border
                            Padding="8,4"
                            Background="#10B981"
                            CornerRadius="4">
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding IsConnected, StringFormat='{}{0}'}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="15"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel
                            Grid.Row="0"
                            Margin="0,0,0,10"
                            LastChildFill="False">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource FontSize.H2.Title}"
                                FontWeight="Bold"
                                Text="数字输入监控 (Digital Input)" />
                            <pf:SearchBar
                                Width="160"
                                Height="28"
                                pf:InfoElement.Placeholder="搜索输入点..."
                                DockPanel.Dock="Right"
                                Text="{Binding InputSearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding InputGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <pf:Divider
                                                Margin="0,10,0,8"
                                                HorizontalContentAlignment="Left"
                                                Content="{Binding CategoryName}"
                                                FontSize="{DynamicResource FontSize.H3.Subtitle}"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                Visibility="{Binding HasVisibleItems, Converter={StaticResource BoolToVis}}" />
                                            <ItemsControl
                                                ItemTemplate="{StaticResource InputPortTemplate}"
                                                ItemsSource="{Binding View}"
                                                Visibility="{Binding HasVisibleItems, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid VerticalAlignment="Top" Columns="2" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="2"
                    Padding="15"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel
                            Grid.Row="0"
                            Margin="0,0,0,10"
                            LastChildFill="False">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    FontSize="{DynamicResource FontSize.H2.Title}"
                                    FontWeight="Bold"
                                    Text="数字输出控制 (Digital Output)" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Bottom"
                                    FontSize="{DynamicResource FontSize.Body.Small}"
                                    Foreground="{DynamicResource OffColor}"
                                    Text="(点击通道按钮可强制切换状态)" />
                            </StackPanel>
                            <pf:SearchBar
                                Width="160"
                                Height="28"
                                pf:InfoElement.Placeholder="搜索输出点..."
                                DockPanel.Dock="Right"
                                Text="{Binding OutputSearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding OutputGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <pf:Divider
                                                Margin="0,10,0,8"
                                                HorizontalContentAlignment="Left"
                                                Content="{Binding CategoryName}"
                                                FontSize="{DynamicResource FontSize.H3.Subtitle}"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                Visibility="{Binding HasVisibleItems, Converter={StaticResource BoolToVis}}" />
                                            <ItemsControl
                                                ItemTemplate="{StaticResource OutputPortTemplate}"
                                                ItemsSource="{Binding View}"
                                                Visibility="{Binding HasVisibleItems, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid VerticalAlignment="Top" Columns="2" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </pf:TransitioningContentControl>
</UserControl>