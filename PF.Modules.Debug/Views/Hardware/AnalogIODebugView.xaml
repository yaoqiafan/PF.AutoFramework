<UserControl
    x:Class="PF.Modules.Debug.Views.AnalogIODebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:opkeys="clr-namespace:PF.Modules.Debug"
    xmlns:oplog="clr-namespace:PF.UI.Infrastructure.Operation;assembly=PF.UI.Infrastructure"
    xmlns:pf="clr-namespace:PF.UI.Controls;assembly=PF.UI.Controls"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:PF.Modules.Debug.ViewModels"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    oplog:OperationLog.PageName="AnalogIODebugView"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--  读数状态色块：正常绿、超量程黄、断线/通讯失败/过期红、未配置灰  -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="#94A3B8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Ok">
                    <Setter Property="Background" Value="#10B981" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="BelowRange">
                    <Setter Property="Background" Value="#F59E0B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="AboveRange">
                    <Setter Property="Background" Value="#F59E0B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="WireBreak">
                    <Setter Property="Background" Value="#EF4444" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="CommError">
                    <Setter Property="Background" Value="#EF4444" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Stale">
                    <Setter Property="Background" Value="#EF4444" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!--  AI 卡片  -->
        <DataTemplate x:Key="InputRowTemplate" DataType="{x:Type vm:AnalogInputRowViewModel}">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Body.Standard}" FontWeight="Bold">
                            <Run Text="AI" /><Run Text="{Binding Channel, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Name, Mode=OneWay}" />
                        </TextBlock>
                        <Border DockPanel.Dock="Right" Style="{StaticResource StatusBadge}">
                            <TextBlock FontSize="{DynamicResource FontSize.Body.Small}" Foreground="White" Text="{Binding StatusText}" />
                        </Border>
                    </DockPanel>

                    <StackPanel Margin="0,8,0,4" Orientation="Horizontal">
                        <TextBlock FontSize="26" FontWeight="Bold" Text="{Binding ValueText}" />
                        <TextBlock Margin="6,0,0,4" VerticalAlignment="Bottom" FontSize="14" Foreground="Gray" Text="{Binding Unit}" />
                    </StackPanel>

                    <ProgressBar Height="6" Maximum="100" Minimum="0" Value="{Binding Percent, Mode=OneWay}" />

                    <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource FontSize.Body.Small}" Foreground="Gray">
                        <Run Text="原始值 " /><Run Text="{Binding RawText, Mode=OneWay}" /><Run Text="   采样 " /><Run Text="{Binding TimeText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="{DynamicResource FontSize.Body.Small}" Foreground="Gray" Text="{Binding RangeText}" />

                    <!--  仿真注入：只在仿真模式显示，修改只在内存  -->
                    <Border
                        Margin="0,8,0,0"
                        Padding="8"
                        Background="#FFF7ED"
                        BorderBrush="#FDBA74"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#9A3412" Text="仿真" />
                            <ComboBox
                                Grid.Column="1"
                                Height="28"
                                DisplayMemberPath="Text"
                                ItemsSource="{Binding SimModeOptions}"
                                SelectedValue="{Binding SimMode}"
                                SelectedValuePath="Mode" />
                            <TextBox
                                Grid.Column="2"
                                Height="28"
                                Margin="6,0"
                                VerticalContentAlignment="Center"
                                oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+AnalogIODebugView.SimValue}"
                                Text="{Binding SimValueText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="3"
                                Height="28"
                                Padding="10,0"
                                oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+AnalogIODebugView.ApplySimValue}"
                                Command="{Binding ApplySimCommand}"
                                Content="注入"
                                Style="{DynamicResource ButtonDefault}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  AO 卡片  -->
        <DataTemplate x:Key="OutputRowTemplate" DataType="{x:Type vm:AnalogOutputRowViewModel}">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Body.Standard}" FontWeight="Bold">
                            <Run Text="AO" /><Run Text="{Binding Channel, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Name, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Foreground="Gray" Text="回读 " />
                            <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding ReadbackText}" />
                            <TextBlock Margin="4,0,0,2" VerticalAlignment="Bottom" Foreground="Gray" Text="{Binding Unit}" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Margin="0,4,0,8" FontSize="{DynamicResource FontSize.Body.Small}" Foreground="Gray" Text="{Binding LimitText}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            Height="30"
                            VerticalContentAlignment="Center"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+AnalogIODebugView.OutputTarget}"
                            Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            Height="30"
                            Margin="6,0"
                            Padding="12,0"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+AnalogIODebugView.WriteOutput}"
                            Command="{Binding WriteCommand}"
                            Content="写出"
                            Style="{DynamicResource ButtonPrimary}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Height="30" Margin="0,0,4,0" Padding="8,0" oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+AnalogIODebugView.QuickWrite}" Command="{Binding QuickWriteCommand}" CommandParameter="0" Content="0%" Style="{DynamicResource ButtonDefault}" ToolTip="写出限幅下限" />
                            <Button Height="30" Margin="0,0,4,0" Padding="8,0" oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+AnalogIODebugView.QuickWrite}" Command="{Binding QuickWriteCommand}" CommandParameter="50" Content="50%" Style="{DynamicResource ButtonDefault}" ToolTip="写出限幅区间中点" />
                            <Button Height="30" Padding="8,0" oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+AnalogIODebugView.QuickWrite}" Command="{Binding QuickWriteCommand}" CommandParameter="100" Content="100%" Style="{DynamicResource ButtonDefault}" ToolTip="写出限幅上限" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource FontSize.Body.Small}" Foreground="#2563EB" Text="{Binding ResultText}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <pf:TransitioningContentControl TransitionMode="Right2LeftWithFade" TransitionStoryboard="{StaticResource Right2LeftWithFadeTransition}">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  设备头信息 + 操作按钮  -->
            <Border Grid.Row="0" Margin="0,0,0,15" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="48" Height="48" Margin="0,0,15,0" CornerRadius="8">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource FontSize.H1.Large}" Foreground="{DynamicResource TextIconBrush}" Text="📈" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="{DynamicResource FontSize.H2.Title}" FontWeight="Bold" Text="{Binding DeviceName}" />
                        <TextBlock Margin="0,4,0,0" FontSize="13" Text="{Binding DeviceDescription}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,20,0" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button Height="32" Margin="0,0,10,0" oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+AnalogIODebugView.Connect}" Command="{Binding ConnectCommand}" Content="连接硬件" Style="{DynamicResource ButtonDefault}" />
                        <Button Height="32" Margin="0,0,10,0" oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+AnalogIODebugView.Disconnect}" Command="{Binding DisconnectCommand}" Content="断开连接" Style="{DynamicResource ButtonDefault}" />
                        <Button Height="32" Margin="0,0,10,0" oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+AnalogIODebugView.Reset}" Command="{Binding ResetCommand}" Content="模块复位" Style="{DynamicResource ButtonWarning}" />
                        <Button Height="32" Margin="0,0,10,0" oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+AnalogIODebugView.ApplySafeOutputs}" Command="{Binding ApplySafeOutputsCommand}" Content="全部回安全值" Style="{DynamicResource ButtonWarning}" ToolTip="把所有配置了安全值的 AO 写回安全值" />
                        <Button Height="32" oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+AnalogIODebugView.SimulateAlarm}" Command="{Binding SimulateAlarmCommand}" Content="模拟报警测试" Style="{DynamicResource ButtonDanger}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Margin="0,0,5,0" VerticalAlignment="Center" Text="通讯状态:" />
                        <Border Padding="8,4" CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#94A3B8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Background" Value="#10B981" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontWeight="SemiBold" Foreground="White" Text="{Binding IsConnected, StringFormat='{}{0}'}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="1">

                <!--  ══════════ 实时监控 ══════════  -->
                <TabItem FontSize="{DynamicResource FontSize.H3.Subtitle}" Header="  实时监控  ">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Margin="0,0,0,10"
                            Padding="10"
                            Background="#FFF3CD"
                            BorderBrush="#FFE69C"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{Binding HasNoChannels, Converter={StaticResource BoolToVis}}">
                            <TextBlock Foreground="#856404" Text="本设备尚未配置任何通道，请到「通道配置」页添加并保存。" />
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="15" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0">
                                <TextBlock Margin="0,0,0,10" DockPanel.Dock="Top" FontSize="{DynamicResource FontSize.H2.Title}" FontWeight="Bold" Text="模拟量输入 (Analog Input)" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemTemplate="{StaticResource InputRowTemplate}" ItemsSource="{Binding Inputs}" />
                                </ScrollViewer>
                            </DockPanel>

                            <DockPanel Grid.Column="2">
                                <StackPanel Margin="0,0,0,10" DockPanel.Dock="Top" Orientation="Horizontal">
                                    <TextBlock FontSize="{DynamicResource FontSize.H2.Title}" FontWeight="Bold" Text="模拟量输出 (Analog Output)" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Bottom" FontSize="{DynamicResource FontSize.Body.Small}" Foreground="Gray" Text="(超出限幅的值会被拒绝写出)" />
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemTemplate="{StaticResource OutputRowTemplate}" ItemsSource="{Binding Outputs}" />
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!--  ══════════ 通道配置 ══════════  -->
                <TabItem FontSize="{DynamicResource FontSize.H3.Subtitle}" Header="  通道配置  ">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" Margin="0,0,0,10" Orientation="Horizontal">
                            <Button Height="30" Margin="0,0,8,0" Padding="10,0" oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+AnalogIODebugView.AddChannel}" Command="{Binding AddInputCommand}" Content="+ AI 通道" Style="{DynamicResource ButtonDefault}" />
                            <Button Height="30" Margin="0,0,8,0" Padding="10,0" oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+AnalogIODebugView.AddChannel}" Command="{Binding AddOutputCommand}" Content="+ AO 通道" Style="{DynamicResource ButtonDefault}" />
                            <Button Height="30" Margin="0,0,20,0" Padding="10,0" oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+AnalogIODebugView.RemoveChannel}" Command="{Binding RemoveChannelCommand}" Content="删除选中" Style="{DynamicResource ButtonDanger}" />

                            <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Body.Standard}" Text="预设" />
                            <ComboBox Width="240" Height="30" Margin="0,0,8,0" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" />
                            <Button Height="30" Margin="0,0,8,0" Padding="10,0" oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+AnalogIODebugView.ApplyPreset}" Command="{Binding ApplyPresetCommand}" Content="套用到选中行" Style="{DynamicResource ButtonDefault}" />
                            <Button Height="30" Margin="0,0,8,0" Padding="10,0" Command="{Binding ApplySignalDefaultsCommand}" Content="按信号类型填原始量程" Style="{DynamicResource ButtonDefault}" />
                            <Button Height="30" Margin="0,0,20,0" Padding="10,0" oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+AnalogIODebugView.SaveAsPreset}" Command="{Binding SaveAsPresetCommand}" Content="选中行存为预设" Style="{DynamicResource ButtonDefault}" />

                            <Button Height="30" Margin="0,0,8,0" Padding="10,0" oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+AnalogIODebugView.RevertChannels}" Command="{Binding RevertChannelsCommand}" Content="撤销修改" Style="{DynamicResource ButtonWarning}" />
                            <Button Height="30" Padding="14,0" oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+AnalogIODebugView.SaveChannels}" Command="{Binding SaveChannelsCommand}" Content="校验并保存" Style="{DynamicResource ButtonPrimary}" ToolTip="需工程师及以上权限；校验通过后立即热更新到设备并写入硬件配置" />
                        </WrapPanel>

                        <DataGrid
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserSortColumns="False"
                            FontSize="{DynamicResource FontSize.Body.Standard}"
                            HeadersVisibility="Column"
                            ItemsSource="{Binding EditChannels}"
                            SelectedItem="{Binding SelectedEditChannel}"
                            SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn Header="方向" ItemsSource="{x:Static vm:AnalogIODebugViewModel.DirectionValues}" SelectedItemBinding="{Binding Direction}" />
                                <DataGridTextColumn Header="通道" Binding="{Binding Channel}" />
                                <DataGridTextColumn MinWidth="110" Header="名称" Binding="{Binding Name}" />
                                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" />
                                <DataGridTextColumn Header="小数位" Binding="{Binding Decimals}" />
                                <DataGridComboBoxColumn Header="信号类型" ItemsSource="{x:Static vm:AnalogIODebugViewModel.SignalTypeValues}" SelectedItemBinding="{Binding SignalType}" />
                                <DataGridTextColumn Header="原始下限" Binding="{Binding RawMin}" />
                                <DataGridTextColumn Header="原始上限" Binding="{Binding RawMax}" />
                                <DataGridTextColumn Header="工程下限" Binding="{Binding EngMin}" />
                                <DataGridTextColumn Header="工程上限" Binding="{Binding EngMax}" />
                                <DataGridTextColumn Header="断线阈值(AI)" Binding="{Binding WireBreakBelowRaw, TargetNullValue=''}" />
                                <DataGridTextColumn Header="输出下限(AO)" Binding="{Binding OutputMin}" />
                                <DataGridTextColumn Header="输出上限(AO)" Binding="{Binding OutputMax}" />
                                <DataGridTextColumn Header="安全值(AO)" Binding="{Binding SafeValue, TargetNullValue=''}" />
                                <DataGridTextColumn Header="模式" Binding="{Binding Mode, TargetNullValue=''}" />
                                <DataGridComboBoxColumn Header="仿真模式" ItemsSource="{x:Static vm:AnalogIODebugViewModel.SimModeValues}" SelectedItemBinding="{Binding SimMode}" />
                                <DataGridTextColumn Header="仿真初值" Binding="{Binding SimValue}" />
                                <DataGridTextColumn Header="跟随AO" Binding="{Binding SimFollowChannel, TargetNullValue=''}" />
                                <DataGridTextColumn Header="滞后ms" Binding="{Binding SimLagMs}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock
                            Grid.Row="2"
                            Margin="0,8,0,0"
                            FontSize="{DynamicResource FontSize.Body.Small}"
                            Foreground="Gray"
                            Text="说明：断线阈值 / 安全值 / 模式 / 跟随AO 留空表示不使用；输出越限一律拒绝写出。修改在「校验并保存」后才生效，保存需工程师及以上权限。" />
                    </Grid>
                </TabItem>
            </TabControl>

            <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="#2563EB">
                <Run Text="{Binding StatusText, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding ConfigStatusText, Mode=OneWay}" />
            </TextBlock>
        </Grid>
    </pf:TransitioningContentControl>
</UserControl>
