<UserControl
    x:Class="PF.Modules.Debug.Views.Hardware.FrameGrabberDebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pf="clr-namespace:PF.UI.Controls;assembly=PF.UI.Controls"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="800"
    d:DesignWidth="1280"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="GroupBorder" TargetType="Border">
            <Setter Property="Padding" Value="15" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.H2.Title}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.Small}" />
        </Style>
        <Style
            x:Key="FieldBox"
            BasedOn="{StaticResource TextBoxBaseStyle}"
            TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="FieldCombo"
            BasedOn="{StaticResource ComboBoxBaseStyle}"
            TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption.Mini}" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="StatePill" TargetType="Border">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>

    <pf:TransitioningContentControl TransitionMode="Right2LeftWithFade" TransitionStoryboard="{StaticResource Right2LeftWithFadeTransition}">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  ══ 头部：设备信息与状态 ══  -->
            <Border
                Grid.Row="0"
                Margin="0,0,0,12"
                Style="{StaticResource GroupBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="4,0,16,0"
                        VerticalAlignment="Center"
                        FontSize="28"
                        Foreground="{DynamicResource TextIconBrush}"
                        Text="🎞" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="{DynamicResource FontSize.H1.Large}"
                            FontWeight="Bold"
                            Text="{Binding DeviceName}" />
                        <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSize.Body.Small}">
                            <Run Text="{Binding DeviceDescription, Mode=OneWay}" />
                            <Run Text="  |  型号: " />
                            <Run Text="{Binding ModelName, Mode=OneWay}" />
                            <Run Text="  |  SN: " />
                            <Run Text="{Binding SerialNumber, Mode=OneWay}" />
                        </TextBlock>
                        <!--  流绑定了哪台相机——流参数可不可写取决于它  -->
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="{DynamicResource FontSize.Caption.Mini}"
                            Foreground="#0284C7"
                            Text="{Binding CurrentStreamDevice, StringFormat='当前流绑定：{0}'}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Text="报警:" />
                        <Border>
                            <Border.Style>
                                <Style BasedOn="{StaticResource StatePill}" TargetType="Border">
                                    <Setter Property="Background" Value="#02AD8B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                            <Setter Property="Background" Value="#EF4444" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding IsAlarm}" />
                        </Border>

                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Text="连接:" />
                        <Border>
                            <Border.Style>
                                <Style BasedOn="{StaticResource StatePill}" TargetType="Border">
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="#EF4444" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Background" Value="#02AD8B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding IsConnected}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ══ 主体：上半区三列（启停 / 本卡相机 / 帧控制），下半区属性树占满全宽 ══  -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="250" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource GroupBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GroupTitle}" Text="设备启停" />
                            <UniformGrid Columns="2">
                                <Button
                                    Height="34"
                                    Margin="0,0,4,8"
                                    Command="{Binding ConnectCommand}"
                                    Content="打开采集卡"
                                    Style="{DynamicResource ButtonDefault}" />
                                <Button
                                    Height="34"
                                    Margin="4,0,0,8"
                                    Command="{Binding DisconnectCommand}"
                                    Content="关闭采集卡"
                                    Style="{DynamicResource ButtonDefault}" />
                            </UniformGrid>
                            <Button
                                Height="34"
                                Margin="0,0,0,8"
                                Command="{Binding ResetCommand}"
                                Content="复位 (RESET)"
                                Style="{DynamicResource ButtonWarning}" />
                            <Button
                                Height="34"
                                Margin="0,0,0,8"
                                Command="{Binding SimulateAlarmCommand}"
                                Content="模拟报警测试"
                                Style="{DynamicResource ButtonDanger}" />
                            <Button
                                Height="32"
                                Command="{Binding RefreshStateCommand}"
                                Content="刷新状态（读回卡上实际值）"
                                Style="{DynamicResource ButtonDefault}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource GroupBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Style="{StaticResource GroupTitle}"
                                Text="本卡相机" />
                            <Button
                                Grid.Row="1"
                                Height="32"
                                Margin="0,0,0,10"
                                Command="{Binding DiscoverCamerasCommand}"
                                Content="枚举本卡下的相机"
                                Style="{DynamicResource ButtonPrimary}" />
                            <ListBox
                                Grid.Row="2"
                                FontFamily="Consolas"
                                FontSize="{DynamicResource FontSize.Caption.Mini}"
                                ItemsSource="{Binding DiscoveredCameras}" />
                        </Grid>
                    </Border>

                    <!--  ── 帧控制 ──  -->
                    <Border Grid.Column="4" Style="{StaticResource GroupBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />

                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Style="{StaticResource GroupTitle}"
                                Text="帧控制 —— CameraLink 的切帧发生在采集卡上" />

                            <ScrollViewer Grid.Row="1"   VerticalScrollBarVisibility="Auto">
                                <StackPanel Orientation="Vertical">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Style="{StaticResource FieldLabel}"
                                            Text="帧长(行)" />
                                        <TextBox
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Style="{StaticResource FieldBox}"
                                            Text="{Binding ImageHeight, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Style="{StaticResource FieldLabel}"
                                            Text="帧超时(ms)" />
                                        <TextBox
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Style="{StaticResource FieldBox}"
                                            Text="{Binding FrameTimeoutMs, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Style="{StaticResource FieldLabel}"
                                            Text="帧触发源" />
                                        <TextBox
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Style="{StaticResource FieldBox}"
                                            Text="{Binding TriggerSource, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="2"
                                            Style="{StaticResource FieldLabel}"
                                            Text="有效边沿" />
                                        <TextBox
                                            Grid.Row="3"
                                            Grid.Column="2"
                                            Style="{StaticResource FieldBox}"
                                            Text="{Binding TriggerActivation, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock
                                            Grid.Row="4"
                                            Grid.Column="0"
                                            Style="{StaticResource FieldLabel}"
                                            Text="流选择器" />
                                        <TextBox
                                            Grid.Row="5"
                                            Grid.Column="0"
                                            Style="{StaticResource FieldBox}"
                                            Text="{Binding StreamSelector, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock
                                            Grid.Row="4"
                                            Grid.Column="2"
                                            Style="{StaticResource FieldLabel}"
                                            Text="相机类型(位宽)" />
                                        <TextBox
                                            Grid.Row="5"
                                            Grid.Column="2"
                                            Style="{StaticResource FieldBox}"
                                            Text="{Binding CameraType, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock
                                            Grid.Row="6"
                                            Grid.Column="0"
                                            Style="{StaticResource FieldLabel}"
                                            Text="残帧策略" />
                                        <TextBox
                                            Grid.Row="7"
                                            Grid.Column="0"
                                            Style="{StaticResource FieldBox}"
                                            Text="{Binding PartialImageControl, UpdateSourceTrigger=PropertyChanged}" />

                                        <CheckBox
                                            Grid.Row="7"
                                            Grid.Column="2"
                                            Margin="0,0,0,10"
                                            VerticalAlignment="Center"
                                            Content="启用帧触发"
                                            IsChecked="{Binding TriggerEnable}" />
                                    </Grid>

                                    <TextBlock
                                        Grid.Row="3"
                                        Margin="0,0,0,12"
                                        Style="{StaticResource Hint}"
                                        Text="留空的项不下发，沿用采集卡当前值；不勾选帧触发即连续模式，攒满帧长自动出图。不同卡型节点集不同，单项失败只记警告——操作结果统一写入底部日志栏。" />

                                    <UniformGrid Grid.Row="4" Columns="2">
                                        <Button
                                            Height="38"
                                            Margin="0,0,6,0"
                                            Command="{Binding ApplyFrameControlCommand}"
                                            Content="下发帧控制配置"
                                            FontWeight="Bold"
                                            Style="{DynamicResource ButtonPrimary}" />
                                        <Button
                                            Height="38"
                                            Margin="6,0,0,0"
                                            Command="{Binding SoftwareTriggerCommand}"
                                            Content="发送帧软触发"
                                            FontWeight="Bold"
                                            Style="{DynamicResource ButtonSuccess}" />
                                    </UniformGrid>
                                </StackPanel>

                            </ScrollViewer>

                        </Grid>
                    </Border>
                </Grid>

                <!--  ── 下半区：属性树（全宽，容得下分类与说明两列）──  -->
                <Border Grid.Row="2" Style="{StaticResource GroupBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  工具条：枚举 / 过滤 / 只看可写  -->
                        <Grid
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Margin="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource GroupTitle}"
                                Text="属性树（采集卡节点）" />
                            <Button
                                Grid.Column="2"
                                Width="140"
                                Height="32"
                                Command="{Binding EnumerateNodesCommand}"
                                Content="枚举全部节点"
                                Style="{DynamicResource ButtonPrimary}" />
                            <TextBox
                                Grid.Column="4"
                                Height="32"
                                VerticalContentAlignment="Center"
                                Style="{StaticResource TextBoxBaseStyle}"
                                Text="{Binding NodeFilter, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="按节点名 / 显示名 / 分类过滤" />
                            <CheckBox
                                Grid.Column="6"
                                VerticalAlignment="Center"
                                Content="只看可写"
                                IsChecked="{Binding WritableNodesOnly}" />
                        </Grid>

                        <DataGrid
                            Grid.Row="1"
                            Grid.Column="0"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            FontSize="{DynamicResource FontSize.Body.Small}"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding Nodes}"
                            SelectedItem="{Binding SelectedNode}"
                            SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="130"
                                    Binding="{Binding Category}"
                                    Header="分类" />
                                <DataGridTextColumn
                                    Width="200"
                                    Binding="{Binding Name}"
                                    Header="节点名" />
                                <!--  中文释义直接成列：节点上千个，靠悬停一个个看太慢  -->
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Description}"
                                    Header="说明">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Style.Triggers>
                                                <!--  英文原文（缺中文条目）压暗+斜体，与中文释义区分  -->
                                                <DataTrigger Binding="{Binding IsDescriptionLocalized}" Value="False">
                                                    <Setter Property="Foreground" Value="#A8B3C2" />
                                                    <Setter Property="FontStyle" Value="Italic" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding NodeType}"
                                    Header="类型" />
                                <DataGridTextColumn
                                    Width="140"
                                    Binding="{Binding Value}"
                                    Header="当前值" />
                                <DataGridTextColumn
                                    Width="60"
                                    Binding="{Binding AccessText}"
                                    Header="权限" />
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style BasedOn="{StaticResource DataGridRowStyle}" TargetType="DataGridRow">
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <MultiBinding StringFormat="{}{0}&#x0a;{1}">
                                                <Binding Path="DisplayName" />
                                                <Binding Path="Description" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <!--  只读节点压暗，一眼看出哪些现在改不了  -->
                                        <DataTrigger Binding="{Binding IsWritable}" Value="False">
                                            <Setter Property="Foreground" Value="#94A3B8" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,8,0,0"
                            Style="{StaticResource Hint}"
                            Text="{Binding NodeSummary}" />

                        <!--  右侧：选中节点的操作区  -->
                        <StackPanel
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Grid.Column="2">
                            <TextBlock Style="{StaticResource GroupTitle}" Text="节点操作" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="节点名（选中左侧行自动填入）" />
                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding NodeName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="节点值" />
                            <!--  可编辑下拉框：数值/字符串直接输入，枚举节点从选中行带出的可选项里挑  -->
                            <ComboBox
                                IsEditable="True"
                                ItemsSource="{Binding NodeEnumEntries}"
                                Style="{StaticResource FieldCombo}"
                                Text="{Binding NodeValue, UpdateSourceTrigger=PropertyChanged}" />

                            <UniformGrid Columns="3">
                                <Button
                                    Height="34"
                                    Margin="0,0,4,0"
                                    Command="{Binding ReadNodeCommand}"
                                    Content="读取"
                                    Style="{DynamicResource ButtonDefault}" />
                                <Button
                                    Height="34"
                                    Margin="2,0"
                                    Command="{Binding WriteNodeCommand}"
                                    Content="写入"
                                    Style="{DynamicResource ButtonDefault}" />
                                <Button
                                    Height="34"
                                    Margin="4,0,0,0"
                                    Command="{Binding ExecuteNodeCommand}"
                                    Content="执行"
                                    Style="{DynamicResource ButtonDefault}" />
                            </UniformGrid>

                            <TextBlock
                                Margin="0,14,0,0"
                                Foreground="#0284C7"
                                Style="{StaticResource Hint}"
                                Text="{Binding SelectedNode.Description}" />

                            <TextBlock
                                Margin="0,14,0,0"
                                Style="{StaticResource Hint}"
                                Text="这里是采集卡自身的节点树，与相机节点树不通用（相机节点在相机调试页）。&#x0a;&#x0a;权限列是取快照那一刻的状态——设备状态一变（相机开关、开流），同一节点可能从「读写」变「只读」，改完状态记得重新枚举。" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </pf:TransitioningContentControl>
</UserControl>
