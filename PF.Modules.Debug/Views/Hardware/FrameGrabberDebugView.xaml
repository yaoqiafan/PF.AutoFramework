<UserControl
    x:Class="PF.Modules.Debug.Views.Hardware.FrameGrabberDebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pf="clr-namespace:PF.UI.Controls;assembly=PF.UI.Controls"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="800"
    d:DesignWidth="1280"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="GroupBorder" TargetType="Border">
            <Setter Property="Padding" Value="15" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.H2.Title}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.Small}" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource TextBoxBaseStyle}">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox" BasedOn="{StaticResource ComboBoxBaseStyle}">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption.Mini}" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="StatePill" TargetType="Border">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>

    <pf:TransitioningContentControl TransitionMode="Right2LeftWithFade" TransitionStoryboard="{StaticResource Right2LeftWithFadeTransition}">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  ══ 头部：设备信息与状态 ══  -->
            <Border
                Grid.Row="0"
                Margin="0,0,0,12"
                Style="{StaticResource GroupBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="4,0,16,0"
                        VerticalAlignment="Center"
                        FontSize="28"
                        Foreground="{DynamicResource TextIconBrush}"
                        Text="🎞" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="{DynamicResource FontSize.H1.Large}"
                            FontWeight="Bold"
                            Text="{Binding DeviceName}" />
                        <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSize.Body.Small}">
                            <Run Text="{Binding DeviceDescription, Mode=OneWay}" />
                            <Run Text="  |  型号: " />
                            <Run Text="{Binding ModelName, Mode=OneWay}" />
                            <Run Text="  |  SN: " />
                            <Run Text="{Binding SerialNumber, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Text="报警:" />
                        <Border>
                            <Border.Style>
                                <Style BasedOn="{StaticResource StatePill}" TargetType="Border">
                                    <Setter Property="Background" Value="#02AD8B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                            <Setter Property="Background" Value="#EF4444" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding IsAlarm}" />
                        </Border>

                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Text="连接:" />
                        <Border>
                            <Border.Style>
                                <Style BasedOn="{StaticResource StatePill}" TargetType="Border">
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="#EF4444" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Background" Value="#02AD8B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding IsConnected}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ══ 主体：三列一屏排满，不设滚动 ══  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>

                <!--  ── 左列：设备启停 + 本卡相机 ──  -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource GroupBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GroupTitle}" Text="设备启停" />
                            <UniformGrid Columns="2">
                                <Button
                                    Height="34"
                                    Margin="0,0,4,8"
                                    Command="{Binding ConnectCommand}"
                                    Content="打开采集卡"
                                    Style="{DynamicResource ButtonDefault}" />
                                <Button
                                    Height="34"
                                    Margin="4,0,0,8"
                                    Command="{Binding DisconnectCommand}"
                                    Content="关闭采集卡"
                                    Style="{DynamicResource ButtonDefault}" />
                            </UniformGrid>
                            <Button
                                Height="34"
                                Margin="0,0,0,8"
                                Command="{Binding ResetCommand}"
                                Content="复位 (RESET)"
                                Style="{DynamicResource ButtonWarning}" />
                            <Button
                                Height="34"
                                Command="{Binding SimulateAlarmCommand}"
                                Content="模拟报警测试"
                                Style="{DynamicResource ButtonDanger}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource GroupBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Style="{StaticResource GroupTitle}"
                                Text="本卡相机" />
                            <Button
                                Grid.Row="1"
                                Height="32"
                                Margin="0,0,0,10"
                                Command="{Binding DiscoverCamerasCommand}"
                                Content="枚举本卡下的相机"
                                Style="{DynamicResource ButtonPrimary}" />
                            <ListBox
                                Grid.Row="2"
                                FontFamily="Consolas"
                                FontSize="{DynamicResource FontSize.Caption.Mini}"
                                ItemsSource="{Binding DiscoveredCameras}" />
                        </Grid>
                    </Border>
                </Grid>

                <!--  ── 中列：帧控制 ──  -->
                <Border Grid.Column="2" Style="{StaticResource GroupBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Style="{StaticResource GroupTitle}"
                            Text="帧控制 —— CameraLink 的切帧发生在采集卡上" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource FieldLabel}"
                                Text="帧长(行)" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource FieldBox}"
                                Text="{Binding ImageHeight, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Style="{StaticResource FieldLabel}"
                                Text="帧超时(ms)" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource FieldBox}"
                                Text="{Binding FrameTimeoutMs, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource FieldLabel}"
                                Text="帧触发源" />
                            <TextBox
                                Grid.Row="3"
                                Grid.Column="0"
                                Style="{StaticResource FieldBox}"
                                Text="{Binding TriggerSource, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="2"
                                Style="{StaticResource FieldLabel}"
                                Text="有效边沿" />
                            <TextBox
                                Grid.Row="3"
                                Grid.Column="2"
                                Style="{StaticResource FieldBox}"
                                Text="{Binding TriggerActivation, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                Style="{StaticResource FieldLabel}"
                                Text="流选择器" />
                            <TextBox
                                Grid.Row="5"
                                Grid.Column="0"
                                Style="{StaticResource FieldBox}"
                                Text="{Binding StreamSelector, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="2"
                                Style="{StaticResource FieldLabel}"
                                Text="相机类型(位宽)" />
                            <TextBox
                                Grid.Row="5"
                                Grid.Column="2"
                                Style="{StaticResource FieldBox}"
                                Text="{Binding CameraType, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="0"
                                Style="{StaticResource FieldLabel}"
                                Text="残帧策略" />
                            <TextBox
                                Grid.Row="7"
                                Grid.Column="0"
                                Style="{StaticResource FieldBox}"
                                Text="{Binding PartialImageControl, UpdateSourceTrigger=PropertyChanged}" />

                            <CheckBox
                                Grid.Row="7"
                                Grid.Column="2"
                                Margin="0,0,0,10"
                                VerticalAlignment="Center"
                                Content="启用帧触发"
                                IsChecked="{Binding TriggerEnable}" />
                        </Grid>

                        <TextBlock
                            Grid.Row="3"
                            Margin="0,0,0,12"
                            Style="{StaticResource Hint}"
                            Text="留空的项不下发，沿用采集卡当前值；不勾选帧触发即连续模式，攒满帧长自动出图。不同卡型节点集不同，单项失败只记警告——操作结果统一写入底部日志栏。" />

                        <UniformGrid Grid.Row="4" Columns="2">
                            <Button
                                Height="38"
                                Margin="0,0,6,0"
                                Command="{Binding ApplyFrameControlCommand}"
                                Content="下发帧控制配置"
                                FontWeight="Bold"
                                Style="{DynamicResource ButtonPrimary}" />
                            <Button
                                Height="38"
                                Margin="6,0,0,0"
                                Command="{Binding SoftwareTriggerCommand}"
                                Content="发送帧软触发"
                                FontWeight="Bold"
                                Style="{DynamicResource ButtonSuccess}" />
                        </UniformGrid>
                    </Grid>
                </Border>

                <!--  ── 右列：高级节点读写 ──  -->
                <Border Grid.Column="4" Style="{StaticResource GroupBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Style="{StaticResource GroupTitle}"
                            Text="高级节点读写" />

                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource FieldLabel}"
                            Text="节点名（如 ImageHeight）" />
                        <TextBox
                            Grid.Row="2"
                            Style="{StaticResource FieldBox}"
                            Text="{Binding NodeName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Grid.Row="3"
                            Style="{StaticResource FieldLabel}"
                            Text="节点值（枚举节点读取后可直接下拉选）" />
                        <!--  可编辑下拉框把"值输入框 + 可选项列表"合成一个控件：数值/字符串节点直接输入，枚举节点读取后从下拉里挑  -->
                        <ComboBox
                            Grid.Row="4"
                            IsEditable="True"
                            ItemsSource="{Binding NodeEnumEntries}"
                            Style="{StaticResource FieldCombo}"
                            Text="{Binding NodeValue, UpdateSourceTrigger=PropertyChanged}" />

                        <UniformGrid Grid.Row="5" Columns="3">
                            <Button
                                Height="32"
                                Margin="0,0,4,0"
                                Command="{Binding ReadNodeCommand}"
                                Content="读取"
                                Style="{DynamicResource ButtonDefault}" />
                            <Button
                                Height="32"
                                Margin="2,0"
                                Command="{Binding WriteNodeCommand}"
                                Content="写入"
                                Style="{DynamicResource ButtonDefault}" />
                            <Button
                                Height="32"
                                Margin="4,0,0,0"
                                Command="{Binding ExecuteNodeCommand}"
                                Content="执行"
                                Style="{DynamicResource ButtonDefault}" />
                        </UniformGrid>

                        <TextBlock
                            Grid.Row="6"
                            Margin="0,12,0,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource Hint}"
                            Text="面板固定字段之外的采集卡节点走这里：先用 MVS 客户端属性树查到节点名，在此试值验证，确认可用后填进配置的 ExtraNodes 由框架自动下发。&#x0a;&#x0a;读取：读当前值，枚举节点会把可选项灌进上面的下拉框。&#x0a;写入：按 枚举→整数→浮点→布尔→字符串 依次尝试。&#x0a;执行：给无参命令节点用（如 DeviceReset / UserSetLoad），值留空。&#x0a;&#x0a;注意：本面板写的是采集卡节点树（IInterface），与相机自身的节点树不通用。" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </pf:TransitioningContentControl>
</UserControl>
