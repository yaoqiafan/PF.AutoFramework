<UserControl
    x:Class="PF.Modules.Debug.Views.CommunicationDebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:PF.Modules.Debug.Models"
    xmlns:pf="clr-namespace:PF.UI.Controls;assembly=PF.UI.Controls"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:tokens="clr-namespace:PF.Core.Constants;assembly=PF.Core"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <pf:TransitioningContentControl TransitionMode="Right2LeftWithFade" TransitionStoryboard="{StaticResource Right2LeftWithFadeTransition}">
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Grid.Column="0"
                Background="{DynamicResource RegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="3"
                CornerRadius="5">
                <DockPanel Grid.Column="0" Margin="5">
                    <TextBlock
                        Margin="12,12,12,4"
                        DockPanel.Dock="Top"
                        FontSize="{DynamicResource FontSize.H1.Large}"
                        FontWeight="SemiBold"
                        Text="通讯综合调试" />

                    <!--  通讯实例分类树：一级=Category，二级=Role（Server/Client，None时扁平挂在Category下），叶子=实例  -->
                    <Border CornerRadius="5">
                        <TreeView
                            BorderBrush="{DynamicResource TextIconBrush}"
                            BorderThickness="1"
                            ItemsSource="{Binding TreeNodes}"
                            SelectedItemChanged="TreeView_SelectedItemChanged"
                            Style="{StaticResource TreeView.Small}">
                            <TreeView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type TreeViewItem}}" TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type models:DebugTreeNode}" ItemsSource="{Binding Children}">
                                    <TextBlock
                                        Margin="0,3"
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource FontSize.Body.Standard}"
                                        Text="{Binding NodeName}" />
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Border>
                </DockPanel>
            </Border>

            <!--  右侧：调试内容区  -->
            <Border Grid.Column="2" CornerRadius="5">
                <ContentControl prism:RegionManager.RegionName="{x:Static tokens:NavigationConstants+Regions.CommunicationViewRegion}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNode}" Value="{x:Null}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ContentControl">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="{DynamicResource FontSize.H3.Subtitle}"
                                                    Foreground="Gray"
                                                    Text="请选择具体通讯实例进行调试" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Border>
        </Grid>
    </pf:TransitioningContentControl>
</UserControl>
