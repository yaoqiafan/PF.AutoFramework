<UserControl
    x:Class="PF.Modules.Debug.Views.Mechanisms.LineScanDetectionModuleDebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oplog="clr-namespace:PF.UI.Infrastructure.Operation;assembly=PF.UI.Infrastructure"
    xmlns:opkeys="clr-namespace:PF.Modules.Debug"
    xmlns:pf="clr-namespace:PF.UI.Controls;assembly=PF.UI.Controls"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="900"
    d:DesignWidth="1500"
    prism:ViewModelLocator.AutoWireViewModel="True"
    oplog:OperationLog.PageName="LineScanDetectionModuleDebugView"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="GroupBorder" TargetType="Border">
            <Setter Property="Padding" Value="15" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.H2.Title}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption.Mini}" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.Small}" />
            <Setter Property="Foreground" Value="#64748B" />
        </Style>
        <Style x:Key="PointDetail" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption.Mini}" />
            <Setter Property="Foreground" Value="#0284C7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DerivedLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.Small}" />
            <Setter Property="Foreground" Value="#64748B" />
        </Style>
        <Style x:Key="DerivedValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.Small}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0284C7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ══ 顶部状态栏：形制与其他模组调试页完全一致 ══  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="15,10"
            Background="#2C3E50"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="0,0,30,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#AAB7B8"
                        Text="当前模组：" />
                    <ComboBox
    Grid.Column="1"
    Height="28"
    VerticalContentAlignment="Center"
    DisplayMemberPath="MechanismName"
    ItemsSource="{Binding Modules}"
    oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+LineScanDetectionModuleDebugView.SelectedModule}"
    SelectedItem="{Binding SelectedModule}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#AAB7B8"
                        Text="已初始化 (IsInitialized)：" />
                    <TextBlock
                        Margin="5,0,0,0"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#00E676"
                        Text="{Binding IsInitialized}" />

                    <TextBlock
                        Margin="15,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#AAB7B8"
                        Text=" | 报警状态 (HasAlarm)：" />
                    <TextBlock
                        Margin="5,0,0,0"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="{Binding HasAlarm}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#00E676" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAlarm}" Value="True">
                                        <Setter Property="Foreground" Value="#E74C3C" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Margin="0,0,20,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#AAB7B8"
                        Text="最后反馈：" />
                    <TextBlock
                        MaxWidth="300"
                        Margin="5,0,0,0"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#F1C40F"
                        Text="{Binding DebugMessage}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Height="35"
                        Margin="0,0,10,0"
                        Padding="15,0"
                        Background="#3498DB"
                        BorderThickness="0"
                        Command="{Binding InitializeModuleCommand}"
                        oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+LineScanDetectionModuleDebugView.InitializeModule}"
                        Content=" 🔄 初始化 (Init) "
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="White">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button
                        Height="35"
                        Margin="0,0,10,0"
                        Padding="15,0"
                        Background="#F39C12"
                        BorderThickness="0"
                        Command="{Binding ResetModuleCommand}"
                        oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+LineScanDetectionModuleDebugView.ResetModule}"
                        Content=" ⚠️ 报警复位 (Reset) "
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="White">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button
                        Height="35"
                        Padding="15,0"
                        Background="#E74C3C"
                        BorderThickness="0"
                        Command="{Binding StopCommand}"
                        oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+LineScanDetectionModuleDebugView.Stop}"
                        Content=" ⏹ 模组停止 (Stop) "
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="White">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ── 左列：起点/终点选择 → 成像参数 → 换算结果，纵向依次排开，整列滚动 ──  -->
            <Border
                Grid.Column="0"
                Style="{StaticResource GroupBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!--  起点/终点：运动参数（位置/速度/加减速/S曲线时间）一律来自选中点位在轴点表里的配置，
                              这里只选"用哪两个点"，不重复编辑运动参数。  -->
                        <TextBlock Style="{StaticResource GroupTitle}" Text="扫描起点 / 终点" />
                        <TextBlock
                            Margin="0,0,0,10"
                            Style="{StaticResource Hint}"
                            Text="位置、速度、加减速、S曲线时间都取自下面选中点位在轴点表里的配置，要改这些请去轴调试页改点表。" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="起点（图像第一行）" />
                                <ComboBox
                                    Height="30"
                                    VerticalContentAlignment="Center"
                                    ItemsSource="{Binding PointNames}"
                                    oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+LineScanDetectionModuleDebugView.SelectedStartPoint}"
                                    SelectedItem="{Binding SelectedStartPointName}" />
                                <TextBlock Style="{StaticResource PointDetail}" Text="{Binding StartPointDetailText}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="终点（图像最后一行）" />
                                <ComboBox
                                    Height="30"
                                    VerticalContentAlignment="Center"
                                    ItemsSource="{Binding PointNames}"
                                    oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+LineScanDetectionModuleDebugView.SelectedEndPoint}"
                                    SelectedItem="{Binding SelectedEndPointName}" />
                                <TextBlock Style="{StaticResource PointDetail}" Text="{Binding EndPointDetailText}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                Height="30"
                                Command="{Binding RefreshPointsCommand}"
                                oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+LineScanDetectionModuleDebugView.RefreshPoints}"
                                Content="刷新点位（点表在别处改过）"
                                Style="{DynamicResource ButtonDefault}" />
                            <Button
                                Grid.Column="2"
                                Height="30"
                                Command="{Binding GotoStartCommand}"
                                oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+LineScanDetectionModuleDebugView.GotoStart}"
                                Content="移动到起点（对位用）"
                                Style="{DynamicResource ButtonDefault}" />
                        </Grid>

                        <!--  曝光：帧长/行频这类成像参数已经配置在相机自己身上（UserSetDefault），
                              这里只留曝光时间——留空表示不下发，沿用相机当前曝光。  -->
                        <TextBlock Style="{StaticResource GroupTitle}" Text="曝光" />
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="曝光时间(μs)（留空 = 不下发，沿用相机当前曝光）" />
                            <TextBox
                                Height="30"
                                VerticalContentAlignment="Center"
                                oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+LineScanDetectionModuleDebugView.ExposureTimeUs}"
                                Text="{Binding ExposureTimeUs, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!--  换算结果：只剩轴几何相关的量，帧长/行频不在这里——已经在相机自己身上  -->
                        <TextBlock Style="{StaticResource GroupTitle}" Text="换算结果" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DerivedLabel}" Text="扫描行程" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DerivedValue}" Text="{Binding ScanLengthText}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DerivedLabel}" Text="理论加减速距离" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DerivedValue}" Text="{Binding AccelDistanceText}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DerivedLabel}" Text="理论帧时间" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DerivedValue}" Text="{Binding FrameTimeText}" />
                        </Grid>

                        <!--  校验结果：通过为绿，有问题逐条列出并转红  -->
                        <Border Margin="0,12,0,0" Padding="10" CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FEF2F2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProfileValid}" Value="True">
                                            <Setter Property="Background" Value="#F0FDF4" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="{DynamicResource FontSize.Body.Small}"
                                Text="{Binding ValidationText}"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#B91C1C" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProfileValid}" Value="True">
                                                <Setter Property="Foreground" Value="#15803D" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <TextBlock
                            Margin="0,12,0,0"
                            Style="{StaticResource Hint}"
                            Text="帧长/行频这类成像参数已经配置在相机自己身上（UserSetDefault），这里不重复计算、不下发覆盖。起点/终点头尾几行的曝光时间会因为还没提上速/正在减速而略有不均——如果这点亮度差异对检测有影响，去轴点表把起点/终点往外多挪一点。" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  ── 右列：扫描与结果预览（跨满整列高度）──  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource GroupBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Width="160"
                            Height="42"
                            Command="{Binding ScanCommand}"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+LineScanDetectionModuleDebugView.Scan}"
                            Content="开始扫描"
                            FontSize="{DynamicResource FontSize.H3.Subtitle}"
                            FontWeight="Bold"
                            Style="{DynamicResource ButtonSuccess}" />
                        <Button
                            Grid.Column="2"
                            Width="110"
                            Height="42"
                            Command="{Binding AbortCommand}"
                            oplog:OperationLog.Key="{x:Static opkeys:OperationLogKeysDebug+LineScanDetectionModuleDebugView.Abort}"
                            Content="中止"
                            Style="{DynamicResource ButtonWarning}" />

                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <TextBlock FontSize="{DynamicResource FontSize.Body.Small}">
                                <Run Foreground="#64748B" Text="扫描轴当前位置：" />
                                <Run
                                    FontFamily="Consolas"
                                    FontWeight="Bold"
                                    Foreground="#0284C7"
                                    Text="{Binding AxisPosition, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock
                                Margin="0,4,0,0"
                                FontFamily="Consolas"
                                FontSize="{DynamicResource FontSize.Body.Small}"
                                Foreground="#0284C7"
                                Text="{Binding ResultText}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="2"
                    Background="{DynamicResource ThirdlyRegionBrush}"
                    Style="{StaticResource GroupBorder}">
                    <Grid>
                        <!--  线扫图又高又窄，缩到面板里看不清细节；ImageViewer 提供缩放/平移/小地图  -->
                        <pf:ImageViewer
                            ImageSource="{Binding PreviewImage}"
                            ShowImgMap="True"
                            ShowToolBar="True" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSize.H3.Subtitle}"
                            Foreground="#94A3B8"
                            IsHitTestVisible="False"
                            Text="{Binding PreviewHint}"
                            TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
