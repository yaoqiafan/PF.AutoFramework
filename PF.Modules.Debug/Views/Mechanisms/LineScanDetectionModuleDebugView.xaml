<UserControl
    x:Class="PF.Modules.Debug.Views.Mechanisms.LineScanDetectionModuleDebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pf="clr-namespace:PF.UI.Controls;assembly=PF.UI.Controls"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="900"
    d:DesignWidth="1400"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="GroupBorder" TargetType="Border">
            <Setter Property="Padding" Value="15" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.H2.Title}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption.Mini}" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DerivedLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.Small}" />
            <Setter Property="Foreground" Value="#64748B" />
        </Style>
        <Style x:Key="DerivedValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.Small}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0284C7" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ══ 顶部状态栏：形制与其他模组调试页完全一致 ══  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="15,10"
            Background="#2C3E50"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="0,0,30,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#AAB7B8"
                        Text="当前模组：" />
                    <TextBlock
                        Margin="5,0,0,0"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding ModuleName}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#AAB7B8"
                        Text="已初始化 (IsInitialized)：" />
                    <TextBlock
                        Margin="5,0,0,0"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#00E676"
                        Text="{Binding IsInitialized}" />

                    <TextBlock
                        Margin="15,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#AAB7B8"
                        Text=" | 报警状态 (HasAlarm)：" />
                    <TextBlock
                        Margin="5,0,0,0"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="{Binding HasAlarm}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#00E676" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAlarm}" Value="True">
                                        <Setter Property="Foreground" Value="#E74C3C" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Margin="0,0,20,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#AAB7B8"
                        Text="最后反馈：" />
                    <TextBlock
                        MaxWidth="300"
                        Margin="5,0,0,0"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#F1C40F"
                        Text="{Binding DebugMessage}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Height="35"
                        Margin="0,0,10,0"
                        Padding="15,0"
                        Background="#3498DB"
                        BorderThickness="0"
                        Command="{Binding InitializeModuleCommand}"
                        Content=" 🔄 初始化 (Init) "
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="White">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button
                        Height="35"
                        Margin="0,0,10,0"
                        Padding="15,0"
                        Background="#F39C12"
                        BorderThickness="0"
                        Command="{Binding ResetModuleCommand}"
                        Content=" ⚠️ 报警复位 (Reset) "
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="White">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button
                        Height="35"
                        Padding="15,0"
                        Background="#E74C3C"
                        BorderThickness="0"
                        Command="{Binding StopCommand}"
                        Content=" ⏹ 模组停止 (Stop) "
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="White">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ── 左列上：扫描配方（PropertyGrid） ──  -->
            <Border
                Grid.Row="0"
                Grid.Column="0"
                Style="{StaticResource GroupBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource GroupTitle}" Text="扫描配方" />

                        <!--  一台设备可能有多条扫描线，各自一个模组实例；顶栏要与其他页一致，故选择器放在这里  -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Text="模组：" />
                            <ComboBox
                                Grid.Column="1"
                                Height="28"
                                VerticalContentAlignment="Center"
                                DisplayMemberPath="MechanismName"
                                ItemsSource="{Binding Modules}"
                                SelectedItem="{Binding SelectedModule}" />
                        </Grid>

                        <TextBlock
                            Margin="0,0,0,10"
                            Style="{StaticResource Hint}"
                            Text="{Binding ModuleInfo}" />
                    </StackPanel>

                    <!--  属性说明写在 [Description] 里，PropertyGrid 直接展示，不必再另设提示文本  -->
                    <pf:PropertyGrid
                        Grid.Row="1"
                        SelectedObject="{Binding Profile}"
                        ShowSortButton="True" />

                    <Button
                        Grid.Row="2"
                        Height="32"
                        Margin="0,10,0,0"
                        Command="{Binding GotoStartCommand}"
                        Content="移动到扫描起点（对位用）"
                        Style="{DynamicResource ButtonDefault}" />
                </Grid>
            </Border>

            <!--  ── 左列下：换算结果 + 校验（与配方同列上下排，改完立刻能对照）──  -->
            <Border
                Grid.Row="2"
                Grid.Column="0"
                Style="{StaticResource GroupBorder}">
                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GroupTitle}" Text="换算结果" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource DerivedLabel}"
                                Text="扫描行程" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource DerivedValue}"
                                Text="{Binding ScanLengthText}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource DerivedLabel}"
                                Text="帧长 = 行程÷行间距" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource DerivedValue}"
                                Text="{Binding FrameHeightText}" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource DerivedLabel}"
                                Text="实际行频 = 速度÷行间距" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource DerivedValue}"
                                Text="{Binding ActualLineRateText}" />

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Style="{StaticResource DerivedLabel}"
                                Text="曝光上限 = 行周期" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource DerivedValue}"
                                Text="{Binding MaxExposureText}" />

                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                Style="{StaticResource DerivedLabel}"
                                Text="理论加减速距离" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                Style="{StaticResource DerivedValue}"
                                Text="{Binding AccelDistanceText}" />

                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="0"
                                Style="{StaticResource DerivedLabel}"
                                Text="轴实走范围" />
                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="1"
                                Style="{StaticResource DerivedValue}"
                                Text="{Binding MoveRangeText}" />

                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="0"
                                Style="{StaticResource DerivedLabel}"
                                Text="理论帧时间" />
                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="1"
                                Style="{StaticResource DerivedValue}"
                                Text="{Binding FrameTimeText}" />
                        </Grid>

                        <!--  校验结果：通过为绿，有问题逐条列出并转红  -->
                        <Border
                            Margin="0,12,0,0"
                            Padding="10"
                            CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FEF2F2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProfileValid}" Value="True">
                                            <Setter Property="Background" Value="#F0FDF4" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="{DynamicResource FontSize.Body.Small}"
                                Text="{Binding ValidationText}"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#B91C1C" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProfileValid}" Value="True">
                                                <Setter Property="Foreground" Value="#15803D" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <TextBlock
                            Margin="0,12,0,0"
                            Style="{StaticResource Hint}"
                            Text="这几个量互相牵制：帧长由行程与行间距决定，行频由速度与行间距决定，行频又反过来限制曝光上限。任何一个填错，症状都只是「图不对」，但原因分别在轴、相机、光学三处——所以在按下扫描之前就把它们摊开。" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  ── 右列：扫描与结果预览（跨满整列高度）──  -->
            <Grid
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource GroupBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Width="160"
                            Height="42"
                            Command="{Binding ScanCommand}"
                            Content="开始扫描"
                            FontSize="{DynamicResource FontSize.H3.Subtitle}"
                            FontWeight="Bold"
                            Style="{DynamicResource ButtonSuccess}" />
                        <Button
                            Grid.Column="2"
                            Width="110"
                            Height="42"
                            Command="{Binding AbortCommand}"
                            Content="中止"
                            Style="{DynamicResource ButtonWarning}" />

                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <TextBlock FontSize="{DynamicResource FontSize.Body.Small}">
                                <Run Foreground="#64748B" Text="扫描轴当前位置：" />
                                <Run
                                    FontFamily="Consolas"
                                    FontWeight="Bold"
                                    Foreground="#0284C7"
                                    Text="{Binding AxisPosition, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock
                                Margin="0,4,0,0"
                                FontFamily="Consolas"
                                FontSize="{DynamicResource FontSize.Body.Small}"
                                Foreground="#0284C7"
                                Text="{Binding ResultText}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="2"
                    Background="{DynamicResource ThirdlyRegionBrush}"
                    Style="{StaticResource GroupBorder}">
                    <Grid>
                        <!--  线扫图又高又窄，缩到面板里看不清细节；ImageViewer 提供缩放/平移/小地图  -->
                        <pf:ImageViewer
                            ImageSource="{Binding PreviewImage}"
                            ShowImgMap="True"
                            ShowToolBar="True" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSize.H3.Subtitle}"
                            Foreground="#94A3B8"
                            IsHitTestVisible="False"
                            Text="{Binding PreviewHint}"
                            TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
