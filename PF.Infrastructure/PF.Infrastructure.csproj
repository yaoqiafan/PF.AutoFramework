<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\Common.props" Condition="Exists('..\Common.props')" />

	<ItemGroup>
		<PackageReference Include="log4net" />
		<PackageReference Include="Stateless" />
		<PackageReference Include="NPOI" />
		<PackageReference Include="System.Drawing.Common" />
		<PackageReference Include="System.IO.Hashing" />
		<PackageReference Include="System.IO.Ports" />
	</ItemGroup>


	<ItemGroup>
	  <ProjectReference Include="..\PF.Core\PF.Core.csproj" />
	  <ProjectReference Include="..\PF.SecsGem.DataBase\PF.SecsGem.DataBase.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <!-- DLL\Infrastructure\ 下这批第三方 SDK 全部由 PF.Vendor.Infrastructure 包对外分发
	       （lib 资产 = 有 <Reference> 的托管封装；runtimes\win-x64\native = 纯 P/Invoke 原生库），
	       两边源文件保持一致，改动/升级时两处都要同步。 -->
	  <!-- ⚠️ 部署要求：托管层内部仍会 P/Invoke 原生 MvCodeReaderCtrl.dll 及其依赖，这些文件不在本仓库、
	       也不随 PF.Vendor.Infrastructure 分发（随包版本与现场 SDK 不一致会导致扫码枪异常，Vendor v1.2.5 已移除），
	       须使用现场机器上扫码枪 SDK 安装的版本。 -->
	  <Reference Include="MvCodeReaderSDK.Net">
	    <HintPath>..\DLL\Infrastructure\MvCodeReaderSDK.Net.dll</HintPath>
	  </Reference>
	  <Reference Include="Keyence.AutoID.SDK">
	    <HintPath>..\DLL\Infrastructure\Keyence.AutoID.SDK.dll</HintPath>
	  </Reference>
	  <Reference Include="Communication">
	    <HintPath>..\DLL\Infrastructure\Communication.dll</HintPath>
	  </Reference>
	  <!-- 海康工业相机 SDK（MVS）托管封装 V2。取自 SDK 安装目录 Development\DotNet\AnyCpu\netstandard2.0。
	       ⚠️ 部署要求：托管层内部仍会 P/Invoke 真正的原生 MvCameraControl.dll，
	       但那个文件从来不在本仓库里（PF.Vendor.Infrastructure 同样没有）——只存在于海康 MVS SDK
	       安装目录的 Libraries\win64 下，需要手动复制到程序输出目录；
	       CameraLink/CXP/XoF 链路还需另行安装采集卡驱动(MVFG)。 -->
	  <Reference Include="MvCameraControl.Net">
	    <HintPath>..\DLL\Infrastructure\MvCameraControl.Net.dll</HintPath>
	  </Reference>
	</ItemGroup>

	<ItemGroup>
	  <!-- 海康网络摄像机 SDK（HCNetSDK，IPC/NVR 私有协议，与 MVS/MvCodeReader 是三套彼此独立的 SDK）。
	       纯 P/Invoke（HCNetSdkApi.cs 按文件名 DllImport），无 <Reference>，全靠复制到输出目录加载。
	       文件实体与其他 SDK 一样在 DLL\Infrastructure\HCNetSDK\；SDK 全套（V6.1.11.5_build20251204_Win64，
	       35 个 53.8MB）存档于 DLL\Infrastructure\HCNetSDK.rar，不参与构建。
	       源码构建：本项目把 PFHCNetSdkNativeDir 指向该目录后 Import Vendor 包里的同一个 targets（ItemGroup 外，见下方），
	       复制规则与外部 PackageReference 消费项目完全一致，经 ProjectReference 传到 Shell 输出目录。
	       外部消费项目：nupkg 不含原生库，装 PF.Vendor.Infrastructure ≥ 1.3.0 即可。
	       ⚠️ 部署要求：仅 Win64（PE Machine=0x8664），进程必须以 x64 运行
	       （AnyCPU 在 64 位 Windows 上默认如此），改 x86/Prefer32Bit 会 BadImageFormatException。

	       ── 只复制 6 个文件（2026-11-03 真机实测，相机 DS-2CD6B45FWD-CX3，SDK V6.1.11.5）──
	       全套 35 个在场时，进程实际加载：登录后 HCNetSDK / HCCore / libcrypto-3-x64 / libssl-3-x64，
	       抓图时（NET_DVR_CaptureJPEGPicture_NEW）再懒加载 HCNetSDKCom\HCCoreDevCfg + HCNetSDKCom\HCPreview。
	       只留这 6 个复跑「登录 → 抓图 → 落盘 → 登出」全部通过；只留前 4 个则登录成功、抓图报
	       [107] 预览组件加载失败 —— 抓图走的是预览组件，且在抓图那一刻才加载，只测登录发现不了。
	       HCNetSDKCom\ 子目录层级是 SDK 硬要求（目录名与相对位置写死在 SDK 内部），targets 用 %(RecursiveDir) 保持层级。
	       未覆盖：NVR / 数字通道（仅测单台 IPC）、实时预览（NET_DVR_RealPlay，框架未用）——
	       若接入这些能力需按同样方法重测，必要时从 DLL\Infrastructure\HCNetSDK.rar 解出补进
	       DLL\Infrastructure\HCNetSDK\（保持子目录层级），本项目与 Vendor 包均无需改动。 -->
	</ItemGroup>
	<PropertyGroup>
		<PFHCNetSdkNativeDir>$(MSBuildThisFileDirectory)..\DLL\Infrastructure\HCNetSDK\</PFHCNetSdkNativeDir>
	</PropertyGroup>
	<Import Project="..\PF.Vendor.Infrastructure\buildTransitive\PF.Vendor.Infrastructure.targets" />

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<Version>2.1.1</Version>
		<PackageReleaseNotes>
v2.1.1 (2026-11-25) — 轴按减速比换算位置 / 速度 / 加减速（需 PF.Core 2.1.2）

[行为变更 — 仅影响轴参数 GearRatio ≠ 1 的轴]
- BaseAxisDevice 对外一律为负载侧单位，收发运动控制卡时按减速比换算：下发的位置 / 速度 / 加减速度乘以减速比，读回的位置除以减速比。
  覆盖 MoveAbsolute / MoveRelative / Jog / Home（回零速度、加减速、偏移）/ PTT 与 PTS 位置表 / CurrentPosition / 软件锁存位置。
- 不换算：S 段时间、回零低速倍率、硬件锁存位置（辅助编码器自己的倍率）、软限位参数（框架内未使用，项目自行下发板卡时需自己换算）。
- 减速比为 1 时数值原样进出板卡，现有配置行为不变；≤ 0 / NaN / 无穷按 1 处理并告警（同一取值只告警一次）。
- ⚠ 板卡的脉冲当量须按电机侧配置；已按负载侧配好脉冲当量的轴保持 1。上机先用小位移核对换算方向。

v2.1.0 (2026-11-20) — SECS 本机通道握手与链路配置下发（需 PF.Core 2.1.0）

[新增 — InternalClient]
- 接入本机服务后互发握手帧：2 秒内没收到服务的握手判为旧版服务（Warn，不阻断，沿用本地 SystemConfigs）；
  协议不兼容记 Error 并指明该升级服务还是主程序。
- 收到服务下发的链路配置帧：写入本地系统参数（内存 + SystemConfigs 表），报文头 DeviceID 立即按新值生效，
  逐字段记录改动；与本地一致时不写库。
- 本地系统参数为空时也照常连接（此前直接返回 false、根本不连，新机器上服务下发的配置永远到不了）。
- DeviceID 非法（非数字、超出 0~32767）时按 0 处理并记 Warn，不再让初始化抛异常。

[新增 — ParamsManger]
- ReplaceSystemParamAsync：先改内存再整表替换 SystemConfigs；写库失败返回 false，内存仍生效。

v2.0.0 (2026-11-19) — PF.AutoFramework 2.0：2026-11 全框架审计修复版

[版本说明]
- 框架大版本：除 PF.Vendor.* 外的全部框架包统一为 2.0.0，须一起升级（各包之间按 2.0.0 互相依赖，不要与 1.x 混用）。
- 2.0.0 之前的版本记录移至本项目目录下的「历史版本记录.md」，此处只记录 2.0.0 起的变更。

[新增 — 模拟量 IO（Hardware/IO/Analog）]
- AnalogChannelEngine：通道表快照、线性换算、断线/超量程判定、AO 限幅（越限拒绝）、仿真（AlwaysPass / Fixed / FollowOutput）。
- CardAnalogIODevice（抽象，AttachedDeviceBase of IAnalogCarrier）：挂运动控制卡下单独使用，或挂 IO 模块下随其分组（不继承节点号）。
  连接时按通道下发 Mode；断开时尽力写安全值；健康检查报 HW_AIO_001 并自动消除。EtherCatAnalogIO 为其薄壳。
- BaseIODevice 实现 IAnalogCarrier；LTMDCMotionCard 新增 IAnalogCard 实现（⚠ 按 SDK 声明实现、尚未上机验证）。
- BaseMechanism.EnsureAnalogChannelsAsync：按枚举补全缺失通道并持久化。

[新增 — 持久化]
- Persistence.AtomicFile：临时文件 + 刷盘 + File.Replace 原子写入；读失败先 BackupCorrupt 再按默认值继续。
  点位表、工站记忆参数、配方、SECS Excel 配置均改用它（此前断电可致点位表被空表永久覆盖）。

[修复 — 报警根因与状态机]
- 工站初始化 / 复位 / 业务循环异常带 StationInitFailed / StationResetFailed / StationWorkflowException 与异常信息上报
  （此前无码 CascadeAlarm 被主控过滤，报警列表为空）。主控初始化 / 复位超时报警并列出未完成工站，超时时长可重写。
- 业务循环未被取消就返回按 StationWorkflowException 报警（⚠ 某模式下直接 return 的工站启动即报警，须实现或等待取消）。
- 主控逐站 Start / Resume 后核对子站进入 Running；自动清除的报警改走 ClearAlarmAutomatically，不再触发工站自动复位。
- 设备连接重试用尽、驱动返回 false 时也报 DeviceConnectFailed；健康监控抑制改为按持有者计数；
  新增 BaseMechanism.InitializeStandaloneAsync（调试页手动初始化后立即恢复监控）。
- 运动：PositioningAccuracy 为 0 时不做到位校验（此前几乎每次误报）；MoveToPointAndWaitAsync 也做到位校验；
  硬件热重载后同 DeviceId 新实例替换旧实例。

[修复 — 通讯]
- TCPClient：ReconnectAsync 在 AutoReconnect=false 时立即重连一次（此前只断不连）；AutoReconnect 对意外断开生效；
  接收循环只清理自己这一代连接。TcpServer accept 异常 1s 退避。
- 文件传输：迟到的 Begin 不再重新登记（分片数少于 Lane 数时 10s 后误报 TransferFailed）；分发阶段断线返回失败结果而非抛异常；
  心跳应答改 TryWrite，避免双向大传输两端接收循环互锁。

[修复 — SECS/GEM]
- 报文头 Device ID 改为大端序（此前 DeviceID=1 被 Host 当成 256）。
- 本机通道（127.0.0.1:6800）自动重连、首连失败转后台重连；断开时发 SecsGemHostDisconnected。
- SecsGemManger.ConnectAsync 先订阅再连接、连接失败也保留订阅：修复 SECS 服务拉起时 Host 的 S1F1 无人应答
  （⚠ 项目自写的 SECS 模组须同样"先订阅后连接"）；InternalClient 无订阅方时记 Warn，不再静默丢弃。
- 报文解析器限制嵌套 64 层并校验列表项数（畸形报文此前可致栈溢出终止进程）；VID 写节点时同步类型，补齐 I1/I2/I8/U1/U8。
- ParamsManger 加载失败记日志、配方读库失败不再报成功；命令管理器部分失败不标记已初始化，修复 GetAllCommandsAsync 必然死锁。
- NPOIHelper 保存 Excel 原子写入并重建同名工作表（此前同一文件只能保存一次）；新增 SecsGemTrace 替换 50+ 处 Console.WriteLine。

[修复 — 配方（BaseRecipe）]
- 读取失败返回结果为 null 的 Task（此前 return null，await 即空引用，Host S7F5 请求不存在的 PPID 收不到回复）。
- 配方名作文件名前校验，拒绝路径分隔符 / 非法字符 / ".."（此前 PPID 可读、删配方目录外任意 .json）。
- 单个配方损坏只跳过；原子写入；备份按项目分目录；删除不存在的配方返回失败。

[修复 — 驱动]
- 雷赛卡：命令类失败日志 Debug→Error；去掉 _unit API 外层多余的 equiv 除 / 乘（现场 equiv=1 行为不变）。
- 扫码枪：新增 BaseBarcodeScan.WaitSignalAsync，替换双线程等待（此前超时后线程泄漏、线程池逐渐占满）。
- 海康串口光源：应答分段拼接、发送前清缓冲，读回亮度不再串值；康视达光源：失败记 Error，断开时清零句柄。
- 基恩士智能相机：PL 指令程序号 :F4 → :D4（⚠ 需上机确认），超时未配置时默认 3000ms。
		</PackageReleaseNotes>
		<Description>底层基础设施：BaseDevice、BaseMechanism、StationBase、TCP 通信基类</Description>
		<GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
	</PropertyGroup>

</Project>
