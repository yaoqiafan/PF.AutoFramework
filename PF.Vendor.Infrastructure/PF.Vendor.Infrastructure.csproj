<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\Common.props" Condition="Exists('..\Common.props')" />

	<PropertyGroup>
		<!-- 本包不产出任何自身的托管程序集，只搬运 PF.Infrastructure 用到的第三方 DLL。
		     IncludeBuildOutput=false 避免把空的 PF.Vendor.Infrastructure.dll 也塞进 nupkg。 -->
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<!-- NU5128：包里既有 lib 资产也有 runtimes 资产，但 lib 资产是第三方厂商程序集、不是本项目编译产物，
		     NuGet 仍会按"本项目自己没有 lib 输出"发出该警告，属预期，压掉。 -->
		<NoWarn>$(NoWarn);NU5128</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!-- 源文件全部收在 DLL\Infrastructure\ 下（与 DLL\HALCON\ 同级并列，按消费方/供应商分文件夹，
		     不再堆在 DLL\ 根目录），PF.Infrastructure.csproj 的 HintPath 引用同一批文件。 -->

		<!-- ===== 有 C# <Reference> 的托管封装：走 lib，PackageReference 本包即可让消费项目在编译期
		     直接拿到类型（配合 PF.Infrastructure 自身仍按 HintPath 编译，两边各自独立，互不冲突）。 ===== -->
		<!-- CopyToOutputDirectory：Pack/PackagePath 只在 dotnet pack 时生效，本包又
		     IncludeBuildOutput=false（没有自身编译产物可流转），本项目一旦被 ProjectReference
		     （例如手工加引用、或联合库调试时误把本包也切成源码引用），这些文件不会被复制到
		     引用方输出目录——两种消费路径都要覆盖，加上这条元数据后 PackageReference（走 NuGet
		     runtimes 资产落地）和 ProjectReference（走本机制）都能正确落地，互不影响。 -->
		<None Include="..\DLL\Infrastructure\Keyence.AutoID.SDK.dll" Pack="true" PackagePath="lib\net8.0\" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\DLL\Infrastructure\Communication.dll" Pack="true" PackagePath="lib\net8.0\" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\DLL\Infrastructure\MvCodeReaderSDK.Net.dll" Pack="true" PackagePath="lib\net8.0\" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\DLL\Infrastructure\MvCodeReaderSDK.Net.xml" Pack="true" PackagePath="lib\net8.0\" CopyToOutputDirectory="PreserveNewest" />
		<!-- MvCameraControl.Net.dll 本身是 AnyCPU 纯 IL（用 CorFlags 核实过，不是 COFF Machine 字段
		     误导的 x86-only），装这个包能解决"托管封装编译期引用不到"的问题；但它内部仍会 P/Invoke
		     真正的原生 MvCameraControl.dll——那个文件从来不在本仓库里，只存在于海康 MVS SDK
		     安装目录的 Libraries\win64 下，这个包没有、也没法打包它。用到线扫相机/CameraLink 采集卡的
		     项目，装完这个包仍需按 PF.Infrastructure.csproj 里那条部署注释，自行从 MVS SDK 安装目录
		     把原生库复制到输出目录，CameraLink/CXP/XoF 链路还要另装 MVFG 采集卡驱动——这部分无法通过
		     NuGet 解决，机器级 SDK 安装是唯一途径。 -->
		<None Include="..\DLL\Infrastructure\MvCameraControl.Net.dll" Pack="true" PackagePath="lib\net8.0\" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\DLL\Infrastructure\MvCameraControl.Net.xml" Pack="true" PackagePath="lib\net8.0\" CopyToOutputDirectory="PreserveNewest" />

		<!-- ===== 纯 P/Invoke 或同一供应商 SDK 内部互相依赖、代码里没有任何 <Reference> 的原生库：
		     走 runtimes\win-x64\native，只要装了本包就会落地到输出目录，不需要程序集引用。
		     ControllerDll.dll / CommonToolDll.dll 由 CtsAPI.cs 按文件名 DllImport；
		     sControllerDll.dll / ControllerDllCSharp.dll 代码里搜不到任何引用，
		     但和前两者同属 CTS 光源控制器 SDK 的同一批次文件，Windows 加载器解析
		     ControllerDll.dll/CommonToolDll.dll 时很可能要在同目录找到它们，因此一并打包、
		     不单独拆分，也不删除——四个文件当一个不可分割的 SDK 整体维护版本。
		     MvCodeReaderSDK.Net.dll（海康扫码枪托管封装）内部 P/Invoke 的原生 MvCodeReaderCtrl.dll
		     不随本包分发：v1.2.0 曾打包，随包版本与现场扫码枪 SDK 不一致会导致扫码枪异常，v1.2.5 移除，
		     必须使用现场机器上扫码枪 SDK 安装的那一份（仓库里的副本也已删除）。
		     消费项目需要设置 <RuntimeIdentifier>win-x64</RuntimeIdentifier> 才能让 dotnet build
		     （而不仅是 dotnet publish）自动把这些文件复制到输出目录。 ===== -->
		<None Include="..\DLL\Infrastructure\LTDMC.dll" Pack="true" PackagePath="runtimes\win-x64\native\" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\DLL\Infrastructure\ControllerDll.dll" Pack="true" PackagePath="runtimes\win-x64\native\" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\DLL\Infrastructure\CommonToolDll.dll" Pack="true" PackagePath="runtimes\win-x64\native\" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\DLL\Infrastructure\sControllerDll.dll" Pack="true" PackagePath="runtimes\win-x64\native\" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\DLL\Infrastructure\ControllerDllCSharp.dll" Pack="true" PackagePath="runtimes\win-x64\native\" CopyToOutputDirectory="PreserveNewest" />

		<!-- ===== 海康网络摄像机 SDK（HCNetSDK）：唯一一组有子目录要求的原生库，不能走 runtimes\win-x64\native\ =====
		     NuGet 落地 native 资产会把子目录平铺（已实测），而 HCNetSDK.dll 要求组件位于同级 HCNetSDKCom\ 下，
		     层级丢了抓图报 [107] 预览组件加载失败。
		     文件实体与其他 SDK 一样放在 DLL\Infrastructure\HCNetSDK\（DLL\Infrastructure\HCNetSDK.rar 是 SDK 全套 35 个的存档，
		     不参与构建）。清单 = 2026-11-03 真机实测的「登录 + JPEG 抓图」最小集 6 个，增删文件只需改这个目录。
		     打包时放进包内 native\HCNetSDK\；三条路径共用 buildTransitive\PF.Vendor.Infrastructure.targets 这一份复制规则：
		     · PackageReference 消费项目：NuGet 自动导入包内同名 targets，默认从包内 native\HCNetSDK\ 取（不需要 RuntimeIdentifier）
		     · PF.Infrastructure 源码构建：其 csproj 设 PFHCNetSdkNativeDir 指向 DLL 目录后 Import 该 targets，经 ProjectReference 传到 Shell
		     · 本项目被 ProjectReference 时：下面同样设属性后 Import（替代 v1.2.4 的 CopyToOutputDirectory 写法） -->
		<!-- 仅打包用（不复制）；PackagePath 写完整文件路径，避免 NuGet 再拼接相对目录 -->
		<None Include="..\DLL\Infrastructure\HCNetSDK\**\*.dll" Pack="true" PackagePath="native\HCNetSDK\%(RecursiveDir)%(Filename)%(Extension)" />
		<!-- SDK 项目默认已把它收为 None，这里用 Update 只追加打包元数据，避免重复项。
		     PackagePath 必须写完整文件路径：只写目录 "buildTransitive\" 时 NuGet 会再拼上项目内的相对目录，
		     打成 buildTransitive\buildTransitive\xxx.targets，消费项目不会导入（已实测踩到）。 -->
		<None Update="buildTransitive\PF.Vendor.Infrastructure.targets" Pack="true" PackagePath="buildTransitive\PF.Vendor.Infrastructure.targets" />
	</ItemGroup>

	<!-- 本项目被 ProjectReference 时的 HCNetSDK 复制规则（与打进包里的是同一个文件，源目录改指仓库 DLL 目录） -->
	<PropertyGroup>
		<PFHCNetSdkNativeDir>$(MSBuildThisFileDirectory)..\DLL\Infrastructure\HCNetSDK\</PFHCNetSdkNativeDir>
	</PropertyGroup>
	<Import Project="buildTransitive\PF.Vendor.Infrastructure.targets" />

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<Version>1.3.0</Version>
		<Description>PF.Infrastructure 依赖的第三方硬件 SDK 原生资产合集（雷赛 LTDMC 运动控制卡、
			CTS 三色灯光源控制器 SDK、基恩士 Keyence.AutoID.SDK、Communication 通讯基础库、
			海康 MvCodeReaderSDK 扫码枪 SDK 含原生驱动、海康 MvCameraControl.Net 相机 SDK 托管封装）。
			这些文件此前只存在于仓库根目录 DLL\Infrastructure\ 下、随框架源码编译时靠 HintPath 就近取用，
			打成 NuGet 包外部消费项目才有办法拿到——不用手动复制，也不会出现版本对不上的问题。
			托管封装（Keyence.AutoID.SDK.dll / Communication.dll / MvCodeReaderSDK.Net.dll /
			MvCameraControl.Net.dll，均为 AnyCPU）走 lib\net8.0\，PackageReference 后即可编译期
			直接引用；纯原生库（LTDMC.dll / ControllerDll.dll / CommonToolDll.dll /
			sControllerDll.dll / ControllerDllCSharp.dll）走 runtimes\win-x64\native\，没有任何 &lt;Reference&gt;，
			全靠 DllImport 按文件名在运行期加载。扫码枪原生库 MvCodeReaderCtrl.dll 不随包分发，须用现场扫码枪 SDK 安装的版本。
			部署要求：消费项目须设置 &lt;RuntimeIdentifier&gt;win-x64&lt;/RuntimeIdentifier&gt;
			（不需要 SelfContained=true），否则 runtimes 下的原生库只在 dotnet publish 时才会被复制，
			dotnet build / F5 调试拿不到文件——不过即便不设置，.NET 的 deps.json 运行期原生库探测机制
			也能从嵌套的 runtimes\win-x64\native\ 子目录找到并成功加载，只是文件不会出现在输出目录
			根部、不便肉眼确认。
			另外：装了本包不代表线扫相机/CameraLink 采集卡就能直接用——MvCameraControl.Net.dll
			内部仍要 P/Invoke 真正的原生 MvCameraControl.dll，那个文件本包没有也无法提供，
			必须从海康 MVS SDK 安装目录的 Libraries\win64 下手动复制，CameraLink/CXP/XoF 链路
			还要另装 MVFG 采集卡驱动。
			海康网络摄像机 SDK（HCNetSDK V6.1.11.5 Win64）：登录 + JPEG 抓图最小集 6 个文件，带 HCNetSDKCom\ 子目录，
			不走 runtimes（NuGet 会平铺子目录），由 buildTransitive targets 构建时按层级复制到输出目录，无需设置 RuntimeIdentifier。</Description>
		<PackageReleaseNotes>
			v1.3.0 — 新增海康网络摄像机 SDK（HCNetSDK）原生库

			[新增]
			- 6 个文件（13.0MB）：HCNetSDK / HCCore / libcrypto-3-x64 / libssl-3-x64 +
			  HCNetSDKCom\HCCoreDevCfg / HCNetSDKCom\HCPreview。供 PF.Infrastructure ≥ 1.0.34 的 HikNetworkCamera 使用，
			  外部项目装本包即可，不再需要从框架仓库手动复制。
			- 清单来自 2026-11-03 真机实测（DS-2CD6B45FWD-CX3）：全套 35 个在场时抓取进程实际加载模块，
			  只留这 6 个复跑登录/抓图/落盘/登出全部通过；缺 HCNetSDKCom 下两个时登录成功但抓图报 [107]。
			  未覆盖 NVR / 数字通道 / 实时预览。
			- 文件实体与其他 SDK 一样放在仓库 DLL\Infrastructure\HCNetSDK\，打包进包内 native\HCNetSDK\；PF.Infrastructure
			  源码构建 Import 同一份 buildTransitive targets（PFHCNetSdkNativeDir 指向 DLL 目录）；SDK 全套存档为
			  DLL\Infrastructure\HCNetSDK.rar，不参与构建。

			[清理]
			- 删除仓库中已不打包的 DLL\Infrastructure\MvCodeReaderCtrl.dll（v1.2.5 已移出包），订正描述里仍称其随包分发的说明。

			[分发方式 — 与本包其他原生库不同]
			- HCNetSDK.dll 要求组件位于同级 HCNetSDKCom\ 子目录；runtimes\win-x64\native\ 落地时会平铺子目录（已实测），
			  所以这 6 个文件放在包内 native\HCNetSDK\，由 buildTransitive\PF.Vendor.Infrastructure.targets 在构建时
			  按层级复制到输出目录。dotnet build / publish 都生效，经其他包间接引用同样生效，不需要设置 RuntimeIdentifier。

			v1.2.5 — 删除MvCodeReaderCtrl.dll引用。

			v1.2.4 — 修复被 ProjectReference 引用时资产不复制的问题

			[修复]
			本包 IncludeBuildOutput=false，自身没有编译产物；全部资产原先只标了
			Pack="true"/PackagePath（只在 dotnet pack 时生效）。正常按 PackageReference 消费走
			NuGet 自己的资产落地机制，没问题；但手工把本包也切成 ProjectReference（比如联合库调试时
			误把它也当框架源码接进去）时，MSBuild 的项目间引用只搬运"被引用项目自身的编译输出"，
			这些纯资产文件完全传不过去——lib 资产（Communication.dll 等）会直接体现为编译期类型找不到，
			runtimes\win-x64\native 下没有 &lt;Reference&gt; 的原生库则更隐蔽：编译能过，只是运行期
			P/Invoke 找不到文件才炸。现在给每个 &lt;None&gt; 项都加上 CopyToOutputDirectory=PreserveNewest，
			PackageReference/ProjectReference 两条路径都能正确落地，互不影响、nupkg 内容不变。

			v1.2.3 — 更新海康扫码枪的dll。

			v1.2.2 — 更新海康扫码枪的dll。

			v1.2.1 — 更新海康扫码枪的dll。

			v1.2.0 — 源文件目录从 DLL\ 根目录搬到 DLL\Infrastructure\（与 DLL\HALCON\ 并列，按消费方分文件夹）；
			新增此前遗漏的 MvCodeReaderCtrl.dll / MvCodeReaderCtrlWrapper.dll——海康扫码枪托管封装
			MvCodeReaderSDK.Net.dll 实际会 P/Invoke 这两个原生库，PF.Infrastructure.csproj 里此前没有
			任何注释提示过，是从一台真实跑通的机器上核实出来的遗漏，走 runtimes\win-x64\native\；
			补充说明不设 RuntimeIdentifier 时 .NET 的 deps.json 原生库探测机制其实也能兜底加载成功，
			只是不便肉眼在输出目录确认文件是否存在。

			v1.1.0 — 新增海康 MvCodeReaderSDK.Net（扫码枪）+ MvCameraControl.Net（相机，含 .xml 文档）两个
			托管封装，与已有的 lib 资产一样走 PackageReference 编译期直接引用。MvCameraControl.Net.dll
			用 CorFlags 核实过是真正的 AnyCPU（ILOnly=true, Requires32Bit=false），此前只看 COFF Machine
			字段误判成"仅限 32 位"是错的，实际不影响 64 位进程加载；但它背后真正的原生 MvCameraControl.dll
			不在本仓库、本包无法打包，线扫/CameraLink 场景仍需按厂商 SDK 安装目录手动补文件（详见上方
			Description 与 PF.Infrastructure.csproj 里的部署注释），这一点本包解决不了。

			v1.0.0 — 首个版本：合并雷赛 LTDMC + CTS 光源控制器 SDK（4 个文件按同一批次整体维护）+
			基恩士 Keyence.AutoID.SDK + Communication 为一个资产包，取代此前"每个 DLL 单独一个包"的
			试点方案——这些文件此前全部只被 PF.Infrastructure 一个项目使用，版本天然绑在一起演进，
			拆成多个小包只会增加发布和版本管理的负担，没有实际收益。
		</PackageReleaseNotes>
	</PropertyGroup>

</Project>
