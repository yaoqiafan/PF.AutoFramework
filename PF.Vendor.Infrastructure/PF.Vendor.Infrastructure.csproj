<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\Common.props" Condition="Exists('..\Common.props')" />

	<PropertyGroup>
		<!-- 本包不产出任何自身的托管程序集，只搬运 PF.Infrastructure 用到的第三方 DLL。
		     IncludeBuildOutput=false 避免把空的 PF.Vendor.Infrastructure.dll 也塞进 nupkg。 -->
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<!-- NU5128：包里既有 lib 资产也有 runtimes 资产，但 lib 资产是第三方厂商程序集、不是本项目编译产物，
		     NuGet 仍会按"本项目自己没有 lib 输出"发出该警告，属预期，压掉。 -->
		<NoWarn>$(NoWarn);NU5128</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!-- ===== 有 C# <Reference> 的托管封装：走 lib，PackageReference 本包即可让消费项目在编译期
		     直接拿到类型（配合 PF.Infrastructure 自身仍按 HintPath 编译，两边各自独立，互不冲突）。 ===== -->
		<None Include="..\DLL\Keyence.AutoID.SDK.dll" Pack="true" PackagePath="lib\net8.0\" />
		<None Include="..\DLL\Communication.dll" Pack="true" PackagePath="lib\net8.0\" />

		<!-- ===== 纯 P/Invoke 或同一供应商 SDK 内部互相依赖、代码里没有任何 <Reference> 的原生库：
		     走 runtimes\win-x64\native，只要装了本包就会落地到输出目录，不需要程序集引用。
		     ControllerDll.dll / CommonToolDll.dll 由 CtsAPI.cs 按文件名 DllImport；
		     sControllerDll.dll / ControllerDllCSharp.dll 代码里搜不到任何引用，
		     但和前两者同属 CTS 光源控制器 SDK 的同一批次文件，Windows 加载器解析
		     ControllerDll.dll/CommonToolDll.dll 时很可能要在同目录找到它们，因此一并打包、
		     不单独拆分，也不删除——四个文件当一个不可分割的 SDK 整体维护版本。
		     消费项目需要设置 <RuntimeIdentifier>win-x64</RuntimeIdentifier> 才能让 dotnet build
		     （而不仅是 dotnet publish）自动把这些文件复制到输出目录。 ===== -->
		<None Include="..\DLL\LTDMC.dll" Pack="true" PackagePath="runtimes\win-x64\native\" />
		<None Include="..\DLL\ControllerDll.dll" Pack="true" PackagePath="runtimes\win-x64\native\" />
		<None Include="..\DLL\CommonToolDll.dll" Pack="true" PackagePath="runtimes\win-x64\native\" />
		<None Include="..\DLL\sControllerDll.dll" Pack="true" PackagePath="runtimes\win-x64\native\" />
		<None Include="..\DLL\ControllerDllCSharp.dll" Pack="true" PackagePath="runtimes\win-x64\native\" />
	</ItemGroup>

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<Version>1.0.0</Version>
		<Description>PF.Infrastructure 依赖的第三方硬件 SDK 原生资产合集（雷赛 LTDMC 运动控制卡、
			CTS 三色灯光源控制器 SDK、基恩士 Keyence.AutoID.SDK、Communication 通讯基础库）。
			这些文件此前只存在于仓库根目录 DLL\ 下、随框架源码编译时靠 HintPath 就近取用，
			打成 NuGet 包外部消费项目才有办法拿到——不用手动复制，也不会出现版本对不上的问题。
			托管封装（Keyence.AutoID.SDK.dll / Communication.dll）走 lib\net8.0\，PackageReference
			后即可编译期直接引用；纯原生库（LTDMC.dll / ControllerDll.dll / CommonToolDll.dll /
			sControllerDll.dll / ControllerDllCSharp.dll）走 runtimes\win-x64\native\，没有任何
			&lt;Reference&gt;，全靠 DllImport 按文件名在运行期加载。
			部署要求：消费项目须设置 &lt;RuntimeIdentifier&gt;win-x64&lt;/RuntimeIdentifier&gt;
			（不需要 SelfContained=true），否则 runtimes 下的原生库只在 dotnet publish 时才会被复制，
			dotnet build / F5 调试拿不到文件。</Description>
		<PackageReleaseNotes>
v1.0.0 — 首个版本：合并雷赛 LTDMC + CTS 光源控制器 SDK（4 个文件按同一批次整体维护）+
基恩士 Keyence.AutoID.SDK + Communication 为一个资产包，取代此前"每个 DLL 单独一个包"的
试点方案——这些文件此前全部只被 PF.Infrastructure 一个项目使用，版本天然绑在一起演进，
拆成多个小包只会增加发布和版本管理的负担，没有实际收益。
		</PackageReleaseNotes>
	</PropertyGroup>

</Project>
