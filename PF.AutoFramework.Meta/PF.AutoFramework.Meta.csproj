    </PackageReleaseNotes>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
    <Description>PF.AutoFramework 一键引用元包，包含全部核心库、UI 组件库及业务模块</Description>
    <!-- 元包无代码产出，抑制 NU5128 警告 -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>

  <!--
    使用 ProjectReference：
    dotnet pack 时 MSBuild 自动将其转换为 PackageId + $(Version) 的 NuGet 依赖，
    版本号取自被引用项目当前 .csproj 中的 <Version>（而非本包自身版本号）。
    注意：各子包版本号在各自 .csproj 中独立声明（见 Directory.Build.props 顶部注释），
    并不随本元包版本统一变化——每次子包有实际改动升级版本号后，本元包也需要
    重新打包/发布一次新版本，否则已发布的旧版本元包会一直指向旧的子包版本。
  -->
  <ItemGroup>
    <ProjectReference Include="..\PF.Core\PF.Core.csproj" />
    <ProjectReference Include="..\PF.SecsGem.DataBase\PF.SecsGem.DataBase.csproj" />
    <ProjectReference Include="..\PF.Data\PF.Data.csproj" />
