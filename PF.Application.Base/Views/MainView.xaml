<UserControl
    x:Class="PF.Application.Base.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pf="clr-namespace:PF.UI.Controls;assembly=PF.UI.Controls"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:PF.Application.Base.ViewModels"
    d:DataContext="{d:DesignInstance vm:MainViewModel, IsDesignTimeCreatable=False}"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource BackgroundBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="MainActionButtonStyle" BasedOn="{StaticResource ButtonDefault}" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <!--
            产品简介展示样式：ContentControl 默认按纯文字（左侧强调竖线 + 多行换行）渲染，
            加载时带一次淡入+右移归位的文字效果；后续如需换成富内容，直接改 Content 或
            重写这个模板即可，不用改绑定或页面结构。
        -->
        <Style x:Key="ProductDescriptionStyle" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border
                            x:Name="RevealRoot"
                            Padding="16,2,0,2"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="3,0,0,0"
                            Opacity="0">
                            <Border.RenderTransform>
                                <TranslateTransform X="16" />
                            </Border.RenderTransform>
                            <TextBlock
                                FontSize="14"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                LineHeight="24"
                                Text="{TemplateBinding Content}"
                                TextWrapping="Wrap" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            BeginTime="0:0:0.15"
                                            Storyboard.TargetName="RevealRoot"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.5" />
                                        <DoubleAnimation
                                            BeginTime="0:0:0.15"
                                            Storyboard.TargetName="RevealRoot"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                            To="0"
                                            Duration="0:0:0.5">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <pf:TransitioningContentControl TransitionMode="Right2LeftWithFade" TransitionStoryboard="{StaticResource Right2LeftWithFadeTransition}">
        <Grid Margin="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <!--  左侧：产品图片卡片  -->
            <Border
                Grid.Column="0"
                Margin="0,0,24,0"
                Background="{DynamicResource RegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid Margin="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        Source="{Binding ProductImagePath}"
                        Stretch="Uniform"
                        Visibility="{Binding ProductImagePath, Converter={StaticResource String2VisibilityConverter}}" />
                    <ContentControl
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Content="{Binding ProductDescription}"
                        Style="{StaticResource ProductDescriptionStyle}"
                        Visibility="{Binding ProductDescription, Converter={StaticResource String2VisibilityConverter}}" />
                </Grid>
            </Border>

            <!--  右侧：品牌信息 + 操作区  -->
            <StackPanel Grid.Column="1">
                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Text="{Binding SoftWareName}"
                    TextWrapping="Wrap" />
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="{Binding CoName}" />
                    <pf:Shield
                        Margin="10,0,0,0"
                        Status="{Binding SoftWareVersion}"
                        Subject="V"
                        Color="{DynamicResource PrimaryBrush}" />
                </StackPanel>

                <Separator Margin="0,24,0,20" />

                <TextBlock
                    Margin="0,0,0,12"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource ThirdlyTextBrush}"
                    Text="常用操作" />

                <Button
                    Command="{Binding OpenManualCommand}"
                    IsEnabled="{Binding HasUserManual}"
                    Style="{StaticResource MainActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <pf:PackIcon
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Kind="BookOpenPageVariantOutline" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="打开说明书" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding CheckUpdateCommand}" Style="{StaticResource MainActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <pf:PackIcon
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Kind="Update" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="检查更新" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding ContactSupportCommand}" Style="{StaticResource MainActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <pf:PackIcon
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Kind="Headset" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="联系技术支持" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding AboutCommand}" Style="{StaticResource MainActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <pf:PackIcon
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Kind="InformationOutline" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="关于软件" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </pf:TransitioningContentControl>
</UserControl>
