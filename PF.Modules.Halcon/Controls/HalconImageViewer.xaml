<UserControl x:Class="PF.Modules.Halcon.Controls.HalconImageViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:halcon="clr-namespace:HalconDotNet;assembly=halcondotnet">

    <Grid>
        <halcon:HWindowControlWPF x:Name="HalconWindow"
                               MouseWheel="HalconWindow_MouseWheel"
                               MouseRightButtonDown="HalconWindow_PanStart"
                               MouseMove="HalconWindow_PanMove"
                               MouseRightButtonUp="HalconWindow_PanEnd"
                               MouseDoubleClick="HalconWindow_FitToWindow"/>
        <!-- 空状态提示 -->
        <TextBlock x:Name="PlaceholderText"
                   Text="无图像"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   FontSize="13"
                   IsHitTestVisible="False"/>
    </Grid>
</UserControl>
