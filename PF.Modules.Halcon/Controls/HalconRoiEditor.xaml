<UserControl
    x:Class="PF.Modules.Halcon.Controls.HalconRoiEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PF.Modules.Halcon.Controls"
    xmlns:pf="clr-namespace:PF.UI.Controls;assembly=PF.UI.Controls"
    FontSize="{DynamicResource FontSize.Body.Standard}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  工具栏  -->
            <RowDefinition Height="*" />
            <!--  图像 + ROI 列表  -->
        </Grid.RowDefinitions>

        <!--
            工具栏：按钮一律图标，不放文字——靠 ToolTip 说明，控件够小，文字标签在缩放/多语言下
            容易挤破工具栏。
        -->
        <ToolBar Grid.Row="0" ToolBarTray.IsLocked="False">
            <!--  操作模式  -->
            <TextBlock
                Margin="0,0,4,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource PrimaryTextBrush}"
                Text="操作:" />
            <RadioButton
                x:Name="IncludeBtn"
                Margin="0,0,2,0"
                Padding="8,3"
                Checked="IncludeBtn_Checked"
                IsChecked="True"
                Style="{DynamicResource RadioButtonIcon}"
                ToolTip="新增 ROI 作为包含区域">
                <pf:PackIcon
                    Width="16"
                    Height="16"
                    Kind="PlusBox" />
            </RadioButton>
            <RadioButton
                x:Name="ExcludeBtn"
                Padding="8,3"
                Checked="ExcludeBtn_Checked"
                Style="{DynamicResource RadioButtonIcon}"
                ToolTip="新增 ROI 作为排除区域">
                <pf:PackIcon
                    Width="16"
                    Height="16"
                    Kind="MinusBox" />
            </RadioButton>
            <Separator Margin="20,0" />
            <!--  形状选择  -->
            <TextBlock
                Margin="0,0,4,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource PrimaryTextBrush}"
                Text="形状:" />
            <Button
                Margin="0,0,5,0"
                Padding="8,3"
                Click="AddRect_Click"
                ToolTip="矩形 ROI">
                <pf:PackIcon
                    Width="16"
                    Height="16"
                    Kind="RectangleOutline" />
            </Button>
            <Button
                Margin="0,0,5,0"
                Padding="8,3"
                Click="AddRect2_Click"
                ToolTip="旋转矩形 ROI">
                <pf:PackIcon
                    Width="16"
                    Height="16"
                    Kind="CropRotate" />
            </Button>
            <Button
                Margin="0,0,5,0"
                Padding="8,3"
                Click="AddCircle_Click"
                ToolTip="圆形 ROI">
                <pf:PackIcon
                    Width="16"
                    Height="16"
                    Kind="CircleOutline" />
            </Button>
            <Button
                Margin="0,0,5,0"
                Padding="8,3"
                Click="AddEllipse_Click"
                ToolTip="椭圆 ROI">
                <pf:PackIcon
                    Width="16"
                    Height="16"
                    Kind="Ellipse" />
            </Button>
            <Button
                Margin="0,0,5,0"
                Padding="8,3"
                Click="AddSector_Click"
                ToolTip="扇形 ROI">
                <pf:PackIcon
                    Width="16"
                    Height="16"
                    Kind="CircleEditOutline" />
            </Button>
            <Separator  Margin="20,0"/>
            <Button HorizontalAlignment="Right"
                x:Name="PreviewBtn"
                Margin="0,0,5,0"
                Padding="8,3"
                Click="PreviewRegion_Click"
                ToolTip="预览检测范围：隐藏工具框，叠层显示 Include − Exclude 的最终检测区域">
                <pf:PackIcon
                    Width="16"
                    Height="16"
                    Kind="Eye" />
            </Button>
            <Button HorizontalAlignment="Right"
                x:Name="ExitPreviewBtn"
                Margin="0,0,5,0"
                Padding="8,3"
                Click="ExitPreview_Click"
                ToolTip="退出预览：清除预览区域，恢复显示工具框"
                Visibility="Collapsed">
                <pf:PackIcon
                    Width="16"
                    Height="16"
                    Kind="EyeOff" />
            </Button>
            <Button HorizontalAlignment="Right"
                Padding="8,3"
                Click="ClearRois_Click"
                ToolTip="清空 ROI">
                <pf:PackIcon
                    Width="16"
                    Height="16"
                    Kind="LayersRemove" />
            </Button>
        </ToolBar>

        <!--  主体：左=图像，右=ROI 列表  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="290" />
            </Grid.ColumnDefinitions>

            <!--  图像显示区  -->
            <local:HalconImageViewer x:Name="ImageViewer" Grid.Column="0" />

            <GridSplitter
                Grid.Column="1"
                Width="3"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource SecondaryRegionBrush}" />

            <!--  ROI 列表  -->
            <DockPanel Grid.Column="2" Margin="4">
                <TextBlock
                    Margin="0,0,0,4"
                    DockPanel.Dock="Top"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Text="ROI 列表" />
                <DataGrid
                    x:Name="RoiGrid"
                    AutoGenerateColumns="False"
                    BorderThickness="1"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    SelectedCellsChanged="RoiGrid_SelectionChanged"
                    SelectionMode="Single"
                    SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="auto"
                            Binding="{Binding Name}"
                            Header="名称" />
                        <DataGridTextColumn
                            Width="auto"
                            Binding="{Binding TypeLabel}"
                            Header="类型"
                            IsReadOnly="True" />
                        <DataGridTemplateColumn Width="*" Header="操作">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        Padding="2,1"
                                        BorderThickness="0"
                                        FontSize="11"
                                        ItemsSource="{x:Static local:HalconRoiEditor.OpLabels}"
                                        SelectedValue="{Binding OpLabel, UpdateSourceTrigger=PropertyChanged}"
                                        SelectionChanged="OpComboBox_SelectionChanged" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Background="Transparent"
                                        BorderThickness="1"
                                        Click="DeleteRoi_Click"
                                        Content="🗑️"
                                        FontSize="15"
                                        Foreground="{DynamicResource  NomalPrimaryBrush}"
                                        Tag="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
