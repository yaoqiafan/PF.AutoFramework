<UserControl
    x:Class="PF.Modules.Halcon.Controls.HalconRoiEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PF.Modules.Halcon.Controls"
    FontSize="{DynamicResource FontSize.Body.Standard}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  
            <!--  工具栏  -->
            <RowDefinition Height="*" />     
            <!--  图像 + ROI 列表  -->
        </Grid.RowDefinitions>

        <!--  工具栏  -->
        <ToolBar Grid.Row="0" ToolBarTray.IsLocked="True">
            <!--  操作模式  -->
            <TextBlock
                Margin="0,0,4,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource PrimaryTextBrush}"
                Text="操作:" />
            <ToggleButton
                x:Name="IncludeBtn"
                Margin="0,0,2,0"
                Padding="8,3"
                Checked="IncludeBtn_Checked"
                Content="+ 包含"
                IsChecked="True"
                ToolTip="新增 ROI 作为包含区域" />
            <ToggleButton
                x:Name="ExcludeBtn"
                Padding="8,3"
                Checked="ExcludeBtn_Checked"
                Content="− 排除"
                ToolTip="新增 ROI 作为排除区域" />
            <Separator />
            <!--  形状选择  -->
            <TextBlock
                Margin="0,0,4,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource PrimaryTextBrush}"
                Text="形状:" />
            <Button
                Margin="0,0,2,0"
                Padding="8,3"
                Click="AddRect_Click"
                Content="□ 矩形" />
            <Button
                Margin="0,0,2,0"
                Padding="8,3"
                Click="AddRect2_Click"
                Content="◧ 旋转矩" />
            <Button
                Margin="0,0,2,0"
                Padding="8,3"
                Click="AddCircle_Click"
                Content="○ 圆" />
            <Button
                Margin="0,0,2,0"
                Padding="8,3"
                Click="AddEllipse_Click"
                Content="◎ 椭圆" />
            <Button
                Margin="0,0,2,0"
                Padding="8,3"
                Click="AddSector_Click"
                Content="⌓ 扇形" />
            <Separator />
            <Button
                x:Name="PreviewBtn"
                Margin="0,0,2,0"
                Padding="8,3"
                Click="PreviewRegion_Click"
                Content="预览检测范围"
                ToolTip="隐藏工具框，叠层显示 Include − Exclude 的最终检测区域" />
            <Button
                x:Name="ExitPreviewBtn"
                Margin="0,0,2,0"
                Padding="8,3"
                Click="ExitPreview_Click"
                Content="退出预览"
                ToolTip="清除预览区域，恢复显示工具框"
                Visibility="Collapsed" />
            <Button
                Padding="8,3"
                Click="ClearRois_Click"
                Content="清空 ROI" />
        </ToolBar>

        <!--  主体：左=图像，右=ROI 列表  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="290" />
            </Grid.ColumnDefinitions>

            <!--  图像显示区  -->
            <local:HalconImageViewer x:Name="ImageViewer" Grid.Column="0" />

            <GridSplitter
                Grid.Column="1"
                Width="3"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource SecondaryRegionBrush}" />

            <!--  ROI 列表  -->
            <DockPanel Grid.Column="2" Margin="4">
                <TextBlock
                    Margin="0,0,0,4"
                    DockPanel.Dock="Top"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Text="ROI 列表" />
                <DataGrid
                    x:Name="RoiGrid"
                    AutoGenerateColumns="False"
                    BorderThickness="1"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    SelectedCellsChanged="RoiGrid_SelectionChanged"
                    SelectionMode="Single"
                    SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="auto"
                            Binding="{Binding Name}"
                            Header="名称" />
                        <DataGridTextColumn
                            Width="auto"
                            Binding="{Binding TypeLabel}"
                            Header="类型"
                            IsReadOnly="True" />
                        <DataGridTemplateColumn Width="*" Header="操作">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        Padding="2,1"
                                        BorderThickness="0"
                                        FontSize="11"
                                        ItemsSource="{x:Static local:HalconRoiEditor.OpLabels}"
                                        SelectedValue="{Binding OpLabel, UpdateSourceTrigger=PropertyChanged}"
                                        SelectionChanged="OpComboBox_SelectionChanged" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Background="Transparent"
                                        BorderThickness="1"
                                        Click="DeleteRoi_Click"
                                        Content="🗑️"
                                        FontSize="15"
                                        Foreground="{DynamicResource DangerBrush}"
                                        Tag="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
