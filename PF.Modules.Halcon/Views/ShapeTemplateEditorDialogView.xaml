<UserControl
    x:Class="PF.Modules.Halcon.Views.ShapeTemplateEditorDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PF.Modules.Halcon.Controls"
    xmlns:local="clr-namespace:PF.Modules.Halcon"
    xmlns:oplog="clr-namespace:PF.UI.Infrastructure.Operation;assembly=PF.UI.Infrastructure"
    FontSize="{DynamicResource FontSize.Body.Standard}"
    oplog:OperationLog.PageName="{x:Static local:HalconNavigationConstants+Dialogs.ShapeTemplateEditor}">

    <!--
        用 WPF 内置转换器，不依赖消费项目是否合并了 PF.UI.Resources 的转换器字典——
        这是框架自己的弹窗，不该假设宿主 App 一定有 Boolean2VisibilityConverter 这个键。
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  参考图行：注入了就只读展示，没注入就给"选参考图"按钮  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,8"
            Orientation="Horizontal">
            <Button
                Margin="0,0,10,0"
                Padding="14,4"
                Command="{Binding SelectReferenceImageCommand}"
                Content="选参考图"
                oplog:OperationLog.Key="{x:Static local:OperationLogKeysHalcon+ShapeTemplateEditorDialog.SelectReferenceImage}"
                Visibility="{Binding ShowSelectImageButton, Converter={StaticResource BoolToVis}}" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource SecondaryTextBrush}"
                Text="{Binding ReferenceImageLabel}" />
        </StackPanel>

        <!--  ROI 编辑器占主体区域  -->
        <controls:HalconRoiEditor x:Name="RoiEditor" Grid.Row="1" />

        <!--  命名 + 加载已有模板微调——"建立模板"不再单独一步，已合并进底部「保存并关闭」
             （见 ShapeTemplateEditorDialogViewModel.ExecuteSave 的文档注释）。  -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Text="模板名称：" />

            <TextBox
                Grid.Column="1"
                VerticalContentAlignment="Center"
                IsEnabled="{Binding CanEditTemplateName}"
                Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="新建模板时可填写；修改已有模板时名称锁定为原模板名，不可修改。"
                oplog:OperationLog.Key="{x:Static local:OperationLogKeysHalcon+ShapeTemplateEditorDialog.TemplateName}" />

            <Button
                Grid.Column="2"
                Margin="8,0,0,0"
                Padding="14,4"
                Command="{Binding LoadTemplateFileCommand}"
                Content="加载模板文件"
                ToolTip="弹文件选择框选一个已存在的模板包（.roipk），把当初的参考图和 ROI 灌回编辑器供微调——名称随之锁定为该模板名，改完 ROI 直接保存即可覆盖"
                oplog:OperationLog.Key="{x:Static local:OperationLogKeysHalcon+ShapeTemplateEditorDialog.LoadTemplateFile}" />

            <TextBlock
                Grid.Column="3"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource ThirdlyTextBrush}"
                Text="{Binding StatusMessage}"
                TextWrapping="Wrap" />
        </Grid>

        <!--  确认/取消  -->
        <StackPanel
            Grid.Row="3"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Margin="0,0,10,0"
                Padding="28,7"
                Command="{Binding ConfirmCommand}"
                Content="保存并关闭"
                oplog:OperationLog.Key="{x:Static local:OperationLogKeysHalcon+ShapeTemplateEditorDialog.SaveAndClose}"
                Style="{DynamicResource ButtonPrimary}" />
            <Button
                Padding="28,7"
                Command="{Binding CancelCommand}"
                Content="取 消"
                oplog:OperationLog.Key="{x:Static local:OperationLogKeysHalcon+ShapeTemplateEditorDialog.Cancel}" />
        </StackPanel>
    </Grid>
</UserControl>
