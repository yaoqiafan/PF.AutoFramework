<UserControl x:Class="PF.Modules.Halcon.Views.PipelineRunnerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:halcon="clr-namespace:HalconDotNet;assembly=halcondotnet"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 工具栏 -->
            <RowDefinition Height="*"/>     <!-- 主体 -->
            <RowDefinition Height="Auto"/>  <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- Row0：工具栏 -->
        <ToolBar Grid.Row="0">
            <ComboBox ItemsSource="{Binding Pipelines}"
                      SelectedItem="{Binding SelectedPipeline, Mode=TwoWay}"
                      DisplayMemberPath="Name"
                      Width="260"
                      VerticalContentAlignment="Center"/>
            <Separator/>
            <Button Content="执行管线" Command="{Binding RunCommand}"     Padding="12,4"/>
            <Button Content="刷新列表" Command="{Binding RefreshCommand}" Padding="8,4" Margin="4,0,0,0"/>
            <Button Content="清除图像" Command="{Binding ClearCommand}"   Padding="8,4" Margin="4,0,0,0"/>
            <Separator/>
            <ProgressBar IsIndeterminate="{Binding IsRunning}" Width="80" Height="12"/>
            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0">
                <Run Text="耗时: "/>
                <Run Text="{Binding LastElapsedMs, Mode=OneWay, StringFormat={}{0:F0} ms}"/>
            </TextBlock>
        </ToolBar>

        <!-- Row1：主体（左=图像显示  右=日志+输出） -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>    <!-- 图像区 -->
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="340"/>  <!-- 日志+输出 -->
            </Grid.ColumnDefinitions>

            <!-- 左：HALCON 图像显示 -->
            <halcon:HWindowControlWPF x:Name="HalconWindow" Grid.Column="0"
                                      Loaded="HalconWindow_Loaded"/>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <!-- 右：日志（上）+ 管线输出（下） -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="180"/>
                </Grid.RowDefinitions>

                <!-- 步骤执行日志 -->
                <DockPanel Grid.Row="0" Margin="8,8,8,4">
                    <TextBlock DockPanel.Dock="Top" Text="执行日志"
                               FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ListBox x:Name="StepLogList"
                             ItemsSource="{Binding StepLogs}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2,1"/>
                                <Setter Property="IsHitTestVisible" Value="False"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"/>

                <!-- 管线输出 DataGrid -->
                <DockPanel Grid.Row="2" Margin="8,4,8,8">
                    <TextBlock DockPanel.Dock="Top" Text="管线输出"
                               FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DataGrid ItemsSource="{Binding Outputs}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="键"  Width="*"
                                                Binding="{Binding Key}"/>
                            <DataGridTextColumn Header="值"  Width="120"
                                                Binding="{Binding Value}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- Row2：状态栏 -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderBrush}"
                Padding="8,4">
            <TextBlock Text="{Binding Status}"
                       Foreground="{DynamicResource ForegroundBrush}"/>
        </Border>
    </Grid>

</UserControl>
