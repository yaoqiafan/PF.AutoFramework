<UserControl
    x:Class="PF.Modules.Halcon.Views.PipelineRunnerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:halcon="clr-namespace:HalconDotNet;assembly=halcondotnet"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  
            <!--  工具栏  -->
            <RowDefinition Height="*" />     
            <!--  主体  -->
            <RowDefinition Height="Auto" />  
            <!--  状态栏  -->
        </Grid.RowDefinitions>

        <!--  Row0：工具栏  -->
        <ToolBar Grid.Row="0">
            <ComboBox
                Width="260"
                VerticalContentAlignment="Center"
                DisplayMemberPath="Name"
                ItemsSource="{Binding Pipelines}"
                SelectedItem="{Binding SelectedPipeline, Mode=TwoWay}" />
            <Separator />
            <Button
                Padding="12,4"
                Command="{Binding RunCommand}"
                Content="执行管线" />
            <Button
                Margin="4,0,0,0"
                Padding="8,4"
                Command="{Binding RefreshCommand}"
                Content="刷新列表" />
            <Button
                Margin="4,0,0,0"
                Padding="8,4"
                Command="{Binding ClearCommand}"
                Content="清除图像" />
            <Separator />
            <ProgressBar
                Width="80"
                Height="12"
                IsIndeterminate="{Binding IsRunning}" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                <Run Text="耗时: " />
                <Run Text="{Binding LastElapsedMs, Mode=OneWay, StringFormat={}{0:F0} ms}" />
            </TextBlock>
        </ToolBar>

        <!--  Row1：主体（左=图像显示  右=日志+输出）  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />    
                <!--  图像区  -->
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="340" />  
                <!--  日志+输出  -->
            </Grid.ColumnDefinitions>

            <!--  左：HALCON 图像显示  -->
            <halcon:HWindowControlWPF
                x:Name="HalconWindow"
                Grid.Column="0"
                Loaded="HalconWindow_Loaded" />

            <GridSplitter
                Grid.Column="1"
                Width="5"
                HorizontalAlignment="Stretch" />

            <!--  右：日志（上）+ 管线输出（下）  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="180" />
                </Grid.RowDefinitions>

                <!--  步骤执行日志  -->
                <DockPanel Grid.Row="0" Margin="8,8,8,4">
                    <TextBlock
                        Margin="0,0,0,4"
                        DockPanel.Dock="Top"
                        FontWeight="SemiBold"
                        Text="执行日志" />
                    <ListBox
                        x:Name="StepLogList"
                        BorderThickness="0"
                        FontFamily="Consolas"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        ItemsSource="{Binding StepLogs}"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2,1" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>

                <GridSplitter
                    Grid.Row="1"
                    Height="5"
                    HorizontalAlignment="Stretch" />

                <!--  管线输出 DataGrid  -->
                <DockPanel Grid.Row="2" Margin="8,4,8,8">
                    <TextBlock
                        Margin="0,0,0,4"
                        DockPanel.Dock="Top"
                        FontWeight="SemiBold"
                        Text="管线输出" />
                    <DataGrid
                        AutoGenerateColumns="False"
                        BorderThickness="0"
                        GridLinesVisibility="None"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding Outputs}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Key}"
                                Header="键" />
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding Value}"
                                Header="值" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </Grid>

        <!--  Row2：状态栏  -->
        <Border
            Grid.Row="2"
            Padding="8,4"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <TextBlock Foreground="{DynamicResource ForegroundBrush}" Text="{Binding Status}" />
        </Border>
    </Grid>

</UserControl>
