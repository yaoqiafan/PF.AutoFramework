<UserControl
    x:Class="PF.Modules.Halcon.Views.VisionPackageEditor.FilePageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PF.Modules.Halcon"
    xmlns:oplog="clr-namespace:PF.UI.Infrastructure.Operation;assembly=PF.UI.Infrastructure"
    xmlns:views="clr-namespace:PF.Modules.Halcon.Views.VisionPackageEditor">

    <UserControl.Resources>
        <ResourceDictionary Source="/PF.Modules.Halcon;component/Views/VisionPackageEditor/EditorStyles.xaml" />
    </UserControl.Resources>

    <StackPanel>
        <views:PageHeaderView />
        <TextBlock Style="{StaticResource VpkSectionTitle}" Text="附件信息" />
        <TextBlock
            Margin="0,0,0,12"
            Foreground="{DynamicResource SecondaryTextBrush}"
            Text="{Binding Info}"
            TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal">
            <Button
                Margin="0,0,8,0"
                Padding="14,5"
                Command="{Binding ImportCommand}"
                Content="导入 / 替换…"
                oplog:OperationLog.Key="{x:Static local:OperationLogKeysHalcon+VisionPackageEditorDialog.ImportFile}"
                Style="{DynamicResource ButtonPrimary}" />
            <Button
                Padding="14,5"
                Command="{Binding ExportCommand}"
                Content="导出…"
                oplog:OperationLog.Key="{x:Static local:OperationLogKeysHalcon+VisionPackageEditorDialog.ExportFile}" />
        </StackPanel>
    </StackPanel>
</UserControl>
