<UserControl x:Class="PF.Modules.Halcon.Views.ProcedureDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:halcon="clr-namespace:HalconDotNet;assembly=halcondotnet"
             xmlns:models="clr-namespace:PF.Modules.Halcon.Models"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 工具栏 -->
            <RowDefinition Height="220"/>    <!-- 参数面板 -->
            <RowDefinition Height="*"/>      <!-- 图像显示 -->
            <RowDefinition Height="160"/>    <!-- 输出结果 -->
        </Grid.RowDefinitions>

        <!-- Row0：工具栏 -->
        <ToolBar Grid.Row="0">
            <TextBlock Text="{Binding ProcedureName}" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="4,0,12,0"/>
            <Separator/>
            <Button Content="执行" Command="{Binding ExecuteCommand}" Padding="12,4"/>
            <Button Content="清除" Command="{Binding ClearCommand}"  Padding="8,4" Margin="4,0,0,0"/>
            <Separator/>
            <ProgressBar IsIndeterminate="{Binding IsExecuting}" Width="80" Height="12"/>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                       Margin="8,0,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
            <Separator/>
            <TextBlock VerticalAlignment="Center" Margin="4,0">
                <Run Text="耗时: "/>
                <Run Text="{Binding LastElapsedMs, Mode=OneWay, StringFormat={}{0:F1} ms}"/>
            </TextBlock>
        </ToolBar>

        <!-- Row1：动态输入参数面板 -->
        <Border Grid.Row="1" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}">
            <DockPanel Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="输入参数"
                           FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding InputParameters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:VisionParameterItem}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="4,2"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Row2：HWindowControlWPF 图像显示区 -->
        <!-- 使用 Loaded 事件替代 HInitWindowCompleted，HWindow 在 Loaded 时已可用 -->
        <halcon:HWindowControlWPF x:Name="HalconWindow" Grid.Row="2"
                                   Loaded="HalconWindow_Loaded"/>

        <!-- Row3：控制量输出结果 -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderBrush}">
            <DockPanel Margin="8,4">
                <TextBlock DockPanel.Dock="Top" Text="输出结果"
                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                <DataGrid ItemsSource="{Binding ControlOutputs}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="变量名" Width="180"
                                            Binding="{Binding Key}"/>
                        <DataGridTextColumn Header="值"     Width="*"
                                            Binding="{Binding Value}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>

</UserControl>
