<UserControl
    x:Class="PF.Modules.Halcon.Views.HalconDebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PF.Modules.Halcon.Controls"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <!--  控制量输入  -->
        <DataTemplate x:Key="InputCtrlTemplate">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Padding="4,2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="#2B7CBB"
                    CornerRadius="3">
                    <TextBlock
                        FontSize="10"
                        Foreground="White"
                        Text="控" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    Margin="8,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Text="{Binding Name}" />
                <TextBox
                    Grid.Column="2"
                    Padding="6,4"
                    VerticalContentAlignment="Center"
                    FontSize="12"
                    Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </DataTemplate>

        <!--
            图像/ROI 输入参数条目。
            避免使用 ContentPresenter，防止 WPF 将 DataContext 作为 Content
            触发 ItemTemplate 递归展开导致 StackOverflow。
        -->
        <DataTemplate x:Key="InputIconicTemplate">
            <StackPanel Margin="0,0,0,8">
                <!--  标签行：图标 / 参数名 / 当前模式 / 切换按钮  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Padding="4,2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#C0611A"
                        CornerRadius="3">
                        <TextBlock
                            FontSize="10"
                            Foreground="White"
                            Text="图" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="{Binding Name}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="{Binding ModeLabelText}" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <!--  文件模式：点击切换到 ROI 模式并打开编辑器  -->
                        <Button
                            Margin="4,0,0,0"
                            Padding="8,3"
                            Command="{Binding ToggleModeCommand}"
                            Content="切换为 ROI 模式"
                            FontSize="11">
                            <Button.Style>
                                <Style BasedOn="{StaticResource ButtonDashedPrimary}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRoiMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!--  ROI 模式：编辑 ROI / 切回文件模式  -->
                        <Button
                            Margin="4,0,2,0"
                            Padding="8,3"
                            Command="{Binding EditRoisCommand}"
                            Content="编辑 ROI"
                            FontSize="11">
                            <Button.Style>
                                <Style BasedOn="{StaticResource ButtonDashedPrimary}" TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRoiMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button
                            Padding="8,3"
                            Command="{Binding ToggleModeCommand}"
                            Content="切回文件模式"
                            FontSize="11">
                            <Button.Style>
                                <Style BasedOn="{StaticResource ButtonDashedWarning}" TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRoiMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  文件路径行（仅文件模式显示）  -->
                <Grid Margin="28,4,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFileMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        Padding="6,4"
                        VerticalContentAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        IsReadOnly="True"
                        Text="{Binding FilePath, TargetNullValue='（未选择图像文件）'}" />
                    <Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="10,4"
                        Command="{Binding BrowseCommand}"
                        Content="浏览…"
                        FontSize="12" />
                </Grid>

                <!--  ROI 模式提示（仅 ROI 模式显示）  -->
                <Border
                    Margin="28,4,0,0"
                    Padding="8,6"
                    CornerRadius="3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Background" Value="#1A2196F3" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRoiMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Text="ROI 绘制模式" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource SecondaryTextBrush}">
                            <Run Text="（已有 " />
                            <Run Text="{Binding CurrentRois.Count, Mode=OneWay}" />
                            <Run Text=" 个 ROI）" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!--  控制量输出  -->
        <DataTemplate x:Key="OutputCtrlTemplate">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Padding="4,2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="#5A7A5A"
                    CornerRadius="3">
                    <TextBlock
                        FontSize="10"
                        Foreground="White"
                        Text="出" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    Margin="8,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    Text="{Binding Name}" />
                <TextBox
                    Grid.Column="2"
                    Padding="6,4"
                    VerticalContentAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    IsReadOnly="True"
                    Text="{Binding Value, TargetNullValue='（调试完成后显示）'}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!--  根：左=配置面板  右=图像/ROI 标签页  -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="480" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ══════════════════ 左：配置面板 ══════════════════  -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Text="HALCON 过程调试（HDevEngine Level 2）" />

                <!--  过程选择  -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="过程文件：" />
                    <ComboBox
                        Grid.Column="1"
                        Padding="6,4"
                        ItemsSource="{Binding Procedures}"
                        SelectedItem="{Binding SelectedProcedure}" />
                    <Button
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Padding="12,4"
                        Command="{Binding RefreshCommand}"
                        Content="刷新" />
                </Grid>

                <!--  参数签名  -->
                <Border
                    Grid.Row="4"
                    Padding="14,10"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Background" Value="{DynamicResource InfoBackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSignature}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Text="输入参数" />
                        <ItemsControl ItemTemplate="{StaticResource InputIconicTemplate}" ItemsSource="{Binding InputIconics}" />
                        <ItemsControl ItemTemplate="{StaticResource InputCtrlTemplate}" ItemsSource="{Binding InputControls}" />

                        <Separator Margin="0,10,0,10" BorderBrush="{DynamicResource BorderBrush}" />
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Text="输出参数" />
                        <ItemsControl ItemTemplate="{StaticResource OutputCtrlTemplate}" ItemsSource="{Binding OutputControls}" />

                        <Grid Margin="0,4,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasOutputIconics}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Padding="4,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="#806040"
                                CornerRadius="3">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="White"
                                    Text="图" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                TextWrapping="Wrap">
                                <Run Text="{Binding OutputIconicSummary, Mode=OneWay}" />
                                <Run FontStyle="Italic" Text="（右侧「图像输出」显示）" />
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <Separator Grid.Row="6" BorderBrush="{DynamicResource BorderBrush}" />

                <TextBlock
                    Grid.Row="8"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Text="调试服务器" />

                <!--  端口 + 密码  -->
                <StackPanel Grid.Row="10" Orientation="Horizontal">
                    <TextBlock
                        Width="44"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="端口：" />
                    <TextBox
                        Width="80"
                        Padding="6,4"
                        VerticalContentAlignment="Center"
                        IsEnabled="{Binding IsNotBusy}"
                        Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Width="44"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="密码：" />
                    <TextBox
                        Width="130"
                        Padding="6,4"
                        VerticalContentAlignment="Center"
                        IsEnabled="{Binding IsNotBusy}"
                        Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="（可留空）" />
                </StackPanel>

                <!--  启动/停止服务器  -->
                <StackPanel Grid.Row="12" Orientation="Horizontal">
                    <Button
                        MinWidth="130"
                        Padding="14,7"
                        Command="{Binding EnableCommand}"
                        Content="启动调试服务器"
                        IsEnabled="{Binding IsNotBusy}"
                        Style="{DynamicResource ButtonInfo}" />
                    <Button
                        MinWidth="130"
                        Margin="10,0,0,0"
                        Padding="14,7"
                        Command="{Binding DisableCommand}"
                        Content="停止调试服务器"
                        IsEnabled="{Binding IsNotBusy}" />
                </StackPanel>

                <!--  启动 HDevelop  -->
                <StackPanel
                    Grid.Row="14"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Padding="14,7"
                        Command="{Binding LaunchCommand}"
                        Content="启动 HDevelop（附加到进程调试）"
                        IsEnabled="{Binding CanLaunchHDevelop}"
                        Style="{DynamicResource ButtonPrimary}">
                        <Button.ToolTip>
                            <TextBlock>
                                <Run FontWeight="SemiBold" Text="调试流程：" />
                                <LineBreak />
                                <Run Text="1. 先点「启动调试服务器」" />
                                <LineBreak />
                                <Run Text="2. 选择过程 + 填写参数" />
                                <LineBreak />
                                <Run Text="3. 点此按钮 → HDevelop 打开，过程在入口暂停" />
                                <LineBreak />
                                <Run Text="4. HDevelop：HDevEngine → 附加到进程 → 输入端口号" />
                                <LineBreak />
                                <Run Text="5. 连接后可断点调试，结束后输出回填本界面" />
                            </TextBlock>
                        </Button.ToolTip>
                    </Button>
                    <Button
                        Margin="10,0,0,0"
                        Padding="10,7"
                        Command="{Binding CancelDebugCommand}"
                        Content="取消调试">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDebugging}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <CheckBox
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Content="打开后直接运行"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        IsChecked="{Binding RunImmediately}" />
                </StackPanel>

                <Separator Grid.Row="16" BorderBrush="{DynamicResource BorderBrush}" />

                <!--  状态指示  -->
                <StackPanel
                    Grid.Row="18"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Ellipse
                        Width="10"
                        Height="10"
                        VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Fill" Value="#4CAF50" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDebugging}" Value="True">
                                        <Setter Property="Fill" Value="#F5A623" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="{Binding ServerStatus}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  引擎耦合自检  -->
                <StackPanel Grid.Row="20">
                    <Button
                        MinWidth="130"
                        Padding="14,7"
                        HorizontalAlignment="Left"
                        Command="{Binding SelfCheckCommand}"
                        Content="引擎耦合自检"
                        IsEnabled="{Binding IsNotBusy}">
                        <Button.ToolTip>
                            <TextBlock>
                                <Run FontWeight="SemiBold" Text="验证调试服务与 Debug 引擎是否真正解耦：" />
                                <LineBreak />
                                <Run Text="① 释放引擎后 IsDebugServerActive 能否回落" />
                                <LineBreak />
                                <Run Text="② 过程枚举 / 签名解析会不会把引擎重新拉起来" />
                                <LineBreak />
                                <Run Text="③ 子目录里的过程能否取到签名（递归查找）" />
                                <LineBreak />
                                <Run FontWeight="SemiBold" Text="注意：自检会停止调试服务器并释放 Debug 引擎。" />
                            </TextBlock>
                        </Button.ToolTip>
                    </Button>
                    <Border
                        Margin="0,10,0,0"
                        Padding="10,8"
                        Background="{DynamicResource RegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelfCheckReport}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            FontFamily="Consolas, Courier New"
                            FontSize="12"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Text="{Binding SelfCheckReport}"
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <GridSplitter
            Grid.Column="1"
            Width="3"
            HorizontalAlignment="Stretch"
            Background="{DynamicResource SecondaryBorderBrush}" />

        <!--  ══════════════════ 右：图像输出 ══════════════════  -->
        <controls:HalconImageViewer
            x:Name="OutputImageViewer"
            Grid.Column="2"
            Loaded="OutputImageViewer_Loaded" />
    </Grid>
</UserControl>
