<UserControl x:Class="PF.Modules.Halcon.Views.HalconDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:controls="clr-namespace:PF.Modules.Halcon.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <!-- 控制量输入条目 -->
        <DataTemplate x:Key="InputCtrlTemplate">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#2B7CBB" CornerRadius="3"
                        Padding="4,2" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="控" FontSize="10" Foreground="White"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Name}"
                           VerticalAlignment="Center" Margin="8,0,8,0"
                           FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBox Grid.Column="2"
                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,4" FontSize="12" VerticalContentAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- 图像/ROI 输入条目 -->
        <DataTemplate x:Key="InputIconicTemplate">
            <StackPanel Margin="0,0,0,8">
                <!-- 第一行：标签 + 参数名 + 模式切换 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#C0611A" CornerRadius="3"
                            Padding="4,2" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="图" FontSize="10" Foreground="White"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                               VerticalAlignment="Center" Margin="8,0,8,0"
                               FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Grid.Column="2" Text="{Binding ModeLabelText}"
                               VerticalAlignment="Center"
                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <Button Grid.Column="3"
                            Content="切换模式"
                            Command="{Binding ToggleModeCommand}"
                            Padding="8,3" FontSize="11" Margin="4,0,0,0"/>
                </Grid>

                <!-- 文件路径行（文件模式） -->
                <Grid Margin="28,4,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFileMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding FilePath, TargetNullValue='（未选择图像文件）'}"
                             IsReadOnly="True"
                             Padding="6,4" FontSize="12" VerticalContentAlignment="Center"
                             Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <Button Grid.Column="1" Content="浏览…"
                            Command="{Binding BrowseCommand}"
                            Margin="8,0,0,0" Padding="10,4" FontSize="12"/>
                </Grid>

                <!-- ROI 编辑器（ROI 模式，由 code-behind 关联） -->
                <Border Margin="28,4,0,0" Height="300"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRoiMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <!-- ROI 编辑器由 code-behind 动态插入到此占位容器 -->
                    <ContentPresenter x:Name="RoiEditorHost"
                                      Tag="{Binding Name}"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- 输出控制量条目 -->
        <DataTemplate x:Key="OutputCtrlTemplate">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#5A7A5A" CornerRadius="3"
                        Padding="4,2" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="出" FontSize="10" Foreground="White"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Name}"
                           VerticalAlignment="Center" Margin="8,0,8,0"
                           FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBox Grid.Column="2"
                         Text="{Binding Value, TargetNullValue='（调试完成后显示）'}"
                         IsReadOnly="True"
                         Padding="6,4" FontSize="12" VerticalContentAlignment="Center"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- 根布局：左=配置面板  右=图像查看器 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="480"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════ 左：配置面板 ═══════════════════════════ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- 0: 标题 -->
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>   <!-- 2: 过程选择 -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>   <!-- 4: 参数区 -->
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>   <!-- 6: 分隔线 -->
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>   <!-- 8: 调试服务器标题 -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>   <!-- 10: 端口 + 密码 -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>   <!-- 12: 启动/停止服务器 -->
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>   <!-- 14: 启动 HDevelop + 取消 -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>   <!-- 16: 分隔线 -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>   <!-- 18: 状态 -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Row="0"
                           Text="HALCON 过程调试（HDevEngine Level 2）"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <!-- 过程选择 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="过程文件："
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Procedures}"
                              SelectedItem="{Binding SelectedProcedure}"
                              Padding="6,4"/>
                    <Button Grid.Column="2" Content="刷新"
                            Command="{Binding RefreshCommand}"
                            Margin="8,0,0,0" Padding="12,4"/>
                </Grid>

                <!-- 参数区 -->
                <Border Grid.Row="4" CornerRadius="4" Padding="14,10" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility"  Value="Collapsed"/>
                            <Setter Property="Background"  Value="{DynamicResource InfoBackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSignature}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="输入参数"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <ItemsControl ItemsSource="{Binding InputIconics}"
                                      ItemTemplate="{StaticResource InputIconicTemplate}"/>
                        <ItemsControl ItemsSource="{Binding InputControls}"
                                      ItemTemplate="{StaticResource InputCtrlTemplate}"/>

                        <Separator Margin="0,10,0,10" BorderBrush="{DynamicResource BorderBrush}"/>
                        <TextBlock Text="输出参数"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <ItemsControl ItemsSource="{Binding OutputControls}"
                                      ItemTemplate="{StaticResource OutputCtrlTemplate}"/>

                        <!-- 图标量输出提示 -->
                        <Grid Margin="0,4,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasOutputIconics}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#806040" CornerRadius="3"
                                    Padding="4,2" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <TextBlock Text="图" FontSize="10" Foreground="White"/>
                            </Border>
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="12"
                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}">
                                <Run Text="{Binding OutputIconicSummary, Mode=OneWay}"/>
                                <Run Text="（右侧图像区显示）" FontStyle="Italic"/>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <Separator Grid.Row="6" BorderBrush="{DynamicResource BorderBrush}"/>

                <!-- 调试服务器标题 -->
                <TextBlock Grid.Row="8"
                           Text="调试服务器"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <!-- 端口 + 密码 -->
                <StackPanel Grid.Row="10" Orientation="Horizontal">
                    <TextBlock Text="端口：" Width="44" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBox Width="80"
                             Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsNotBusy}"
                             VerticalContentAlignment="Center" Padding="6,4"/>
                    <TextBlock Text="密码：" Margin="16,0,0,0" Width="44" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBox Width="130"
                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsNotBusy}"
                             VerticalContentAlignment="Center" Padding="6,4"/>
                    <TextBlock Text="（可留空）" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                </StackPanel>

                <!-- 启动/停止服务器 -->
                <StackPanel Grid.Row="12" Orientation="Horizontal">
                    <Button Content="启动调试服务器"
                            Command="{Binding EnableCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Padding="14,7" MinWidth="130"
                            Style="{DynamicResource PrimaryButtonStyle}"/>
                    <Button Content="停止调试服务器"
                            Command="{Binding DisableCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Margin="10,0,0,0" Padding="14,7" MinWidth="130"/>
                </StackPanel>

                <!-- 启动 HDevelop + 取消 + 选项 -->
                <StackPanel Grid.Row="14" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="启动 HDevelop（附加到进程调试）"
                            Command="{Binding LaunchCommand}"
                            IsEnabled="{Binding CanLaunchHDevelop}"
                            Padding="14,7"
                            Style="{DynamicResource AccentButtonStyle}">
                        <Button.ToolTip>
                            <TextBlock>
                                <Run FontWeight="SemiBold" Text="调试流程："/>
                                <LineBreak/>
                                <Run Text="1. 先点「启动调试服务器」"/>
                                <LineBreak/>
                                <Run Text="2. 选择过程 + 填写参数"/>
                                <LineBreak/>
                                <Run Text="3. 点此按钮 → HDevelop 打开，过程在入口暂停"/>
                                <LineBreak/>
                                <Run Text="4. 在 HDevelop 中：HDevEngine → 附加到进程 → 输入端口号"/>
                                <LineBreak/>
                                <Run Text="5. 连接后可断点调试，完成后输出回填本界面"/>
                            </TextBlock>
                        </Button.ToolTip>
                    </Button>

                    <Button Content="取消调试"
                            Command="{Binding CancelDebugCommand}"
                            Margin="10,0,0,0" Padding="10,7">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDebugging}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.ToolTip>关闭 HDevelop 或断开连接后，调试会话自动结束</Button.ToolTip>
                    </Button>

                    <CheckBox Content="打开后直接运行"
                              IsChecked="{Binding RunImmediately}"
                              Margin="12,0,0,0" VerticalAlignment="Center"
                              Foreground="{DynamicResource PrimaryTextBrush}"/>
                </StackPanel>

                <Separator Grid.Row="16" BorderBrush="{DynamicResource BorderBrush}"/>

                <!-- 状态 -->
                <StackPanel Grid.Row="18" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Fill" Value="#4CAF50"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDebugging}" Value="True">
                                        <Setter Property="Fill" Value="#F5A623"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ServerStatus}"
                               Margin="8,0,0,0"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

        <!-- ═══════════════════════════ 右：图像查看器 ═══════════════════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="图像输出"
                       FontSize="13" FontWeight="SemiBold"
                       Margin="8,8,8,4"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            <controls:HalconImageViewer x:Name="OutputImageViewer"
                                        Grid.Row="1"
                                        Loaded="OutputImageViewer_Loaded"/>
        </Grid>
    </Grid>
</UserControl>
